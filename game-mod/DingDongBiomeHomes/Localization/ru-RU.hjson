	RandomLoot: {
		Configs: {
			RandomLootConfig: {
				ChestLootRandomizer: {
					Tooltip: ""
					Label: Случайная добыча из сундуков
				}

				BossLootRandomizer: {
					Tooltip: ""
					Label: Случайная добыча с боссов
				}

				EnemyLootRandomizer: {
					Tooltip: ""
					Label: Случайная добыча с врагов
				}

				DisplayName: Настройки случайной добычи
			}

			ChestLootRandomization: {
				Tooltip: ""

				RandomChestLoot: {
					Tooltip:
						'''
						Включает или выключает вероятность случайной добычи в сундуках.
						Примечание:
						- Максимальный размер стака складываемых предметов — 5.
						- Заполняются только ячейки, где изначально был предмет.
						- Работает только в новом мире, созданном после включения настройки. Сундуки заполняются при создании мира.
						'''
					Label: Случайная добыча в сундуках
				}

				DetailedChestRandomLootChance: {
					Tooltip:
						'''
						Дополнительная вероятность прибавляется к дробной части вероятности случайной добычи.
						Пример:
						Вероятность случайной добычи в сундуке равна 1, дополнительная вероятность — 0.25.
						Вместе они дают 1.25%. Возможны любые сочетания.
						'''
					Label: Дополнительная вероятность добычи в сундуках
				}

				ChestRandomLootChance: {
					Tooltip:
						'''
						Вероятность появления случайного предмета в каждой ячейке сундука.
						Влияет только на случайную добычу в сундуках.
						'''
					Label: Вероятность случайной добычи в сундуках
				}
			}

			BossLootRandomization: {
				Tooltip: ""

				RandomBossDrops: {
					Tooltip: Включает или выключает вероятность выпадения случайной добычи с боссов.
					Label: Случайные выпадения с боссов
				}

				DetailedBossRandomLootChance: {
					Tooltip:
						'''
						Дополнительная вероятность прибавляется к дробной части вероятности случайной добычи.
						Пример:
						Вероятность случайной добычи с босса равна 1, дополнительная вероятность — 0.25.
						Вместе они дают 1.25%. Возможны любые сочетания.
						'''
					Label: Дополнительная вероятность добычи с боссов
				}

				BossRandomLootChance: {
					Tooltip:
						'''
						Вероятность выпадения случайной добычи с боссов в %. 
						Влияет только на случайные выпадения с боссов.
						'''
					Label: Вероятность случайной добычи с боссов
				}
			}

			EnemyLootRandomization: {
				Tooltip: ""

				RandomEnemyLoot: {
					Tooltip: Включает или выключает вероятность выпадения случайной добычи с обычных врагов.
					Label: Случайные выпадения с врагов
				}

				DetailedEnemyRandomLootChance: {
					Tooltip:
						'''
						Дополнительная вероятность прибавляется к дробной части вероятности случайной добычи.
						Пример:
						Вероятность случайной добычи с врага равна 1, дополнительная вероятность — 0.25.
						Вместе они дают 1.25%. Возможны любые сочетания.
						'''
					Label: Дополнительная вероятность добычи с врагов
				}

				EnemyRandomLootChance: {
					Tooltip:
						'''
						Вероятность выпадения случайной добычи с врагов в %. 
						Влияет только на случайные выпадения с врагов.
						'''
					Label: Вероятность случайной добычи с врагов
				}
			}
		}
	}

