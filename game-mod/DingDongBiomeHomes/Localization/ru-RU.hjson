				ModIntegrationTerrariaOverhaul: {
					Label: "[i:509] Переключатель: Terraria Overhaul"
					Tooltip:
						'''
						Скрывает отрисовку предмета при выборе оружия с прицеливанием. 
						Чтобы использовать отрисовку WeaponOut, выключите «{$Mods.WeaponOutLite.Configs.WeaponOutClientConfig.ModIntegrationTerrariaOverhaul.Label}», а также 
						отключите постоянный показ оружия с прицеливанием в визуальных настройках Terraria Overhaul.
						'''
				}

				ModIntegrationMeleeEffectsPlus: {
					Label: "[i:509] Переключатель: Melee Effects+"
					Tooltip: Применяет исправление, помогающее различать типы мечей. По умолчанию включено.
				}

				ModIntegrationVibrantReverie: {
					Label: "[i:1344] Автоматически: Vibrant Reverie"
					Tooltip: Поддерживается интеграция Mod Call. Спасибо, W1K [i:58]!
				}

				ModIntegrationOverhaulGunAnimations: {
					Label: "[i:2701] Вручную: Overhaul Gun Animations"
					Tooltip: Чтобы устранить конфликты отрисовки, включите стандартную анимацию прицеливания в настройках Overhaul Gun Animations.
				}

				ModIntegrationArmamentDisplay: {
					Label: "[i:2701] Вручную: ArmamentDisplay"
					Tooltip: Чтобы устранить конфликты отрисовки, выключите показ оружия в настройках визуальных эффектов ArmamentDisplay.
				}

				ModIntegrationArmamentDisplayLite: {
					Label: "[i:1344] Автоматически: ArmamentDisplayLite"
					Tooltip: Отключает стойки покоя для оружия в этом моде. Остаётся предположить, что именно ради этого вы установили оба мода.
				}

				ModIntegrationCoolerItemVisualEffect: {
					Label: "[i:2701] Вручную: CoolerItemVisualEffect"
					Tooltip: Чтобы устранить конфликты отрисовки, в расширенных настройках CoolerItemVisualEffect откройте прочие настройки и выключите показ оружия.
