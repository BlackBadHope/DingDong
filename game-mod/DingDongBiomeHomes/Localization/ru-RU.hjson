			}

			FishSteakRecipesConfig: {
				DisplayName: Рецепты рыбных стейков

				fishRecipes: {
					Label: Количество рыбных стейков
					Tooltip: Предметы, которые можно превратить в рыбные стейки. Изменение требует перезагрузки модов.
				}

				fishRecipesNotAuto: {
					Label: Рыба, которую не разрезает рыборез
					Tooltip: Предметы, которые рыборез и врата разделки не должны автоматически превращать в рыбные стейки. Перезагрузка модов не требуется.
				}
			}

			FishToReplaceConfig: {
				DisplayName: Замена улова

				replaceAllFish: {
					Label: Заменять любой улов
					Tooltip: Позволяет моду заменять любые выловленные предметы своими. Если включено, список ниже не учитывается.
				}

				fishToReplace: {
					Label: Заменяемый улов
					Tooltip: Выловленные предметы, которые могут заменяться предметами этого мода. Перезагрузка модов не требуется.
				}
			}

			UnuServerConfig: {
				DisplayName: Настройки сервера UnuBattleRods

				allowPrefixes: {
					Label: Разрешить модификаторы удочек
					Tooltip: Позволяет этому моду назначать удочкам модификаторы. Отключите, чтобы усложнить игру.
				}

				allowBorrowDamage: {
					Label: Заимствовать бонус урона других классов
					Tooltip: Использовать прежнюю систему: наибольший бонус урона среди обычных классов применяется к урону удочек.
				}

				allowFishedItems: {
					Label: Разрешить улов этого мода
					Tooltip: Позволяет вылавливать ящики, добавленные этим модом.
				}

				dontFallOnFloor: {
					Label: Поплавки всегда ломаются
					Tooltip: При отзыве с цели поплавки всегда ломаются вместо падения на землю.
				}

				explosivesDamageEveryone: {
					Label: Взрывчатка наносит урон всем
					Tooltip: Будут ли гранатные и динамитные поплавки наносить урон всем, включая использовавшего их игрока.
				}

				noSellItems: {
					Label: Предметы, запрещённые к продаже
					Tooltip: Торговые врата и врата разделки не будут заменять эти предметы монетами.
				}

				forceSellItems: {
					Label: Предметы для обязательной продажи
					Tooltip:
						'''
						Торговые врата и врата разделки заменяют эти предметы монетами, даже если их предел стопки больше 1.

						Внимание: этот список имеет приоритет над всеми остальными заменами. Если добавить сюда весь заменяемый улов, ящики перестанут попадаться. Это также имеет приоритет над превращением в рыбные стейки.
						'''
				}
			}
		}

