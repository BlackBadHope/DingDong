	StructureHelper: {
		Items: {
			ChestWand: {
				DisplayName: Палочка сундуков
				Tooltip:
					'''
					Применение:
					- Правая кнопка открывает меню правил сундука
					- Настройте правила генерации сундуков в этом меню
					- Нажмите левой кнопкой на сундук, чтобы применить к нему текущие правила

					Другое применение:
					- Нажмите правой кнопкой на сундук с правилами, чтобы скопировать их в меню
					'''
			}

			MultistructureWand: {
				DisplayName: Палочка мультиструктур
				Tooltip:
					'''
					Применение:
					- Двумя нажатиями левой кнопки выделите углы структуры
					- Затем нажмите правой кнопкой, чтобы добавить структуру в текущую мультиструктуру
					- Повторите для всех нужных структур
					- Когда закончите, нажмите правой кнопкой на предмет в инвентаре, чтобы сохранить мультиструктуру
					'''
			}

			StructureWand: {
				DisplayName: Палочка структур
				Tooltip:
					'''
					Применение:
					- Двумя нажатиями левой кнопки выделите углы структуры
					- Нажмите правой кнопкой, чтобы сохранить структуру
					'''
			}

			TestWand: {
				DisplayName: Палочка размещения структур
				Tooltip:
					'''
					Применение:
					- Правая кнопка открывает выбор структуры
					- Левая кнопка размещает выбранную структуру
					'''
			}

			NullBlockItem: {
				DisplayName: Пропускающий блок
				Tooltip:
					'''
					Указывает в структуре места, где генератор
					должен оставить существующее содержимое мира без изменений
					(не влияет на стены: для них используйте пропускающие стены)
					'''
			}

			NullTileAndWallPlacer: {
				DisplayName: Совмещённый установщик пропусков
				Tooltip: Одновременно размещает пропускающий блок и пропускающую стену
			}

			NullWallItem: {
				DisplayName: Пропускающая стена
				Tooltip:
					'''
					Указывает в структуре места, где генератор
					должен оставить существующие стены мира без изменений
					(только для стен: для прочих данных используйте пропускающие блоки)
					'''
			}

			PortingWand: {
				DisplayName: Палочка переноса формата
				Tooltip:
					'''
					Применение:
					- Поместите все структуры версий до 3.0 в папку SavedStructures
					- Используйте предмет в игре, чтобы автоматически преобразовать все структуры в SavedStructures
					- Замените старые файлы структур новыми файлами '.shstruct' и '.shmstruct'
					'''
			}

			CustomDataWand: {
				DisplayName: Палочка пользовательских данных
				Tooltip:
					'''
					Продвинутый инструмент. Позволяет включать и выключать сохранение зарегистрированных пользовательских данных блоков в структурах.
					Подробнее в документации: (https://github.com/ScalarVector1/StructureHelper/wiki/Saving-Custom-Data)
					'''
			}
		}
	}

