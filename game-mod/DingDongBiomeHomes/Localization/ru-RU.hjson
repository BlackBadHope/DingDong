	LootBeams: {
		Configs: {
			LootBeamConfig: {
				DisplayName: Настройки

				ColorOverrides: {
					Label: Переопределение цветов
					Tooltip:
						'''
						Позволяет задавать цвет луча добычи для отдельных предметов.
						Общее определение цвета для всей редкости пока не поддерживается.
						Примечание: альфа-канал не используется, но для точного предпросмотра цвета его следует установить на 255.
						'''
				}

				CustomWhitelist: {
					Label: Пользовательский список разрешений
					Tooltip: У этих предметов луч добычи будет ВСЕГДА, независимо от условий.
				}

				CustomBlacklist: {
					Label: Пользовательский список исключений
					Tooltip:
						'''
						У этих предметов луча добычи не будет НИКОГДА, независимо от условий.
						Имеет приоритет над пользовательским списком разрешений.
						'''
				}

				UseMiniBeam: {
					Label: Уменьшенные лучи
					Tooltip:
						'''
						Для этих предметов размер луча добычи всегда равен 0.5. Обычно используется для валюты или чтобы меньше отвлекать.
						Прозрачность, как обычно, влияет на луч и свечение по отдельности.
						'''
				}

				BeamStyle: {
					Label: Стиль луча
					Tooltip:
						'''
						Позволяет менять внешний вид луча.
						0 отключает эффект.
						1 — простой, 2 — стрелка, 3 — анимированная стрелка
						'''
				}

				GlowStyle: {
					Label: Стиль свечения
					Tooltip:
						'''
						Позволяет менять внешний вид свечения.
						0 отключает эффект.
						Дополнительные стили пока не реализованы.
						'''
				}

				MinRarity: {
					Label: Минимальная редкость
					Tooltip:
						'''
						Минимальная редкость предмета для появления луча добычи.
						Значение -2 полностью отключает лучи для предметов без персональных правил (см. пользовательские переопределения).
						Диапазон: от -2 до 11
						По умолчанию: 1
						'''
				}

				MinValue: {
					Label: Минимальная стоимость
					Tooltip:
						'''
						Сколько должен стоить предмет в медных монетах, чтобы появился луч добычи?
						Помните: серебряная монета равна 100 медным, золотая — 10,000 медных,
						а платиновая — 1,000,000 медных.
						Здесь учитывается цена ПОКУПКИ, а не продажи,
						поэтому цену приобретения предмета стоит уточнить в соответствующей вики.
						Диапазон: 0 и выше
						По умолчанию: 1
						'''
				}

				HighlightQuest: {
					Label: Всегда выделять квестовые предметы
					Tooltip:
						'''
						Всегда выделяет такие предметы.
						Имеет приоритет над минимальной стоимостью.
						По умолчанию: включено
						'''
				}

				HighlightExpert: {
					Label: Всегда выделять предметы эксперта
					Tooltip:
						'''
						Всегда выделяет такие предметы.
						Имеет приоритет над минимальной стоимостью.
						По умолчанию: включено
						'''
				}

				HighlightMaster: {
					Label: Всегда выделять предметы мастера
					Tooltip:
						'''
						Всегда выделяет такие предметы.
						Имеет приоритет над минимальной стоимостью.
						По умолчанию: включено
						'''
				}

				BeamScale: {
					Label: Масштаб луча
					Tooltip:
						'''
						Задаёт масштаб луча.
						Для предметов из списка уменьшенных лучей масштаб всегда равен 0.5
						Диапазон: от 0.5 до 2.0
						По умолчанию: 0.75
						'''
				}

				BeamOpacity: {
					Label: Непрозрачность луча
					Tooltip:
						'''
						Задаёт непрозрачность.
						Диапазон: от 0.0 до 1.0
						По умолчанию: 1.0
						'''
				}

				GlowScale: {
					Label: Масштаб свечения
					Tooltip:
						'''
						Задаёт масштаб луча.
						Для предметов из списка уменьшенных лучей масштаб всегда равен 0.5
						Диапазон: от 0.5 до 2.0
						По умолчанию: 0.75
						'''
				}

				GlowOpacity: {
					Label: Непрозрачность свечения
					Tooltip:
						'''
						Задаёт непрозрачность.
						Диапазон: от 0.0 до 1.0
						По умолчанию: 1.0
						'''
				}

				FlashScale: {
					Label: Масштаб вспышки
					Tooltip:
						'''
						Размер вспышки при появлении луча
						Значение 1.0 фактически отключает вспышку
						Для уменьшенных лучей вспышка не появляется
						Диапазон: от 1.0 до 10.0
						По умолчанию: 7.5
						'''
				}

				DrawAdditive: {
					Label: Более яркие лучи
					Tooltip:
						'''
						При включении лучи добычи рисуются с аддитивным смешиванием
						Это делает их ярче, особенно на светлом фоне
						Без него лучи выглядят темнее, зато точнее передают цвет
						Настройка игнорируется при установленном Shape of Light из-за известной несовместимости
						По умолчанию: включено
						'''
				}
			}
		}
	}

