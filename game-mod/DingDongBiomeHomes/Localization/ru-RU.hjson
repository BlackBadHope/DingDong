			}

			SuperiorBaitDisperser: {
				DisplayName: Улучшенный распылитель наживки
				Tooltip: Накладывает отрицательные эффекты используемой наживки на всех врагов в радиусе 16 блоков
			}

			UrgencyBobSpeeder: {
				DisplayName: Экстренный ускоритель поплавка
				Tooltip: Чем меньше у вас здоровья, тем чаще бьёт поплавок: ускорение до 75%
			}

			Wormicide: {
				DisplayName: Червебой
				Tooltip: Удваивает урон поплавка, прикреплённого к червеобразному врагу
			}

			BlazingFishingKnife: {
				DisplayName: Пылающий рыбацкий нож
				Tooltip:
					'''
					Раз в секунду атакует врагов совсем рядом с вами
					Базовый урон: 80
					Среднее отбрасывание
					Накладывает солнечное пламя
					Двойной урон по врагам, прикреплённым к вашему поплавку
					'''
			}

			FishingKnife: {
				DisplayName: Рыбацкий нож
				Tooltip:
					'''
					Раз в секунду атакует врагов совсем рядом с вами
					Базовый урон: 40
					Среднее отбрасывание
					Двойной урон по врагам, прикреплённым к вашему поплавку
					'''
			}

			FractaliteFishingKnife: {
				DisplayName: Фракталитовый рыбацкий нож
				Tooltip:
					'''
					Дважды в секунду атакует врагов рядом с вами
					Базовый урон: 120
					Сильное отбрасывание
					Накладывает ледяное пламя
					Двойной урон по врагам, прикреплённым к вашему поплавку
					'''
			}

			WoodenFishingKnife: {
				DisplayName: Деревянный рыбацкий нож
				Tooltip:
					'''
					Раз в 2 секунды атакует врагов почти вплотную к вам
					Базовый урон: 15
					Слабое отбрасывание
					Двойной урон по врагам, прикреплённым к вашему поплавку
					'''
			}

			BobLoser: {
				DisplayName: Сократитель лесок
				Tooltip: Уменьшает число лесок удочки на одну. Всегда оставляет хотя бы одну леску.
			}

			BoxOfCountlessLures: {
				DisplayName: Коробка бесчисленных приманок
				Tooltip: Позволяет забрасывать 32 дополнительные лески
			}

			BoxOfLures: {
				DisplayName: Коробка приманок
				Tooltip: Позволяет забрасывать 16 дополнительных лесок
			}

			DoubleBobLoser: {
				DisplayName: Двойной сократитель лесок
				Tooltip: Уменьшает число лесок удочки на две. Всегда оставляет хотя бы одну леску.
			}

			DoubleLure: {
				DisplayName: Двойная приманка
				Tooltip: Позволяет забрасывать 2 дополнительные лески
			}

			DoubleSelectiveBobbers: {
				DisplayName: Двойные избирательные поплавки
				Tooltip: К одному врагу прикрепляются не более двух поплавков
			}

			ExtraLure: {
				DisplayName: Дополнительная приманка
				Tooltip: Позволяет забрасывать одну дополнительную леску
