		Projectiles.CursedEffectProjectile.DisplayName: Снаряд проклятого эффекта
		SortingOption.InfusionPower.Tooltip: Сила насыщения
		TableText.xp: Опыт

		Configs: {
			ClientConfig.LogDummyDPS.Label: Включить расчёт и запись урона в секунду по тренировочному манекену

			ServerConfig: {
				AffectOnVanillaLifeStealLimmit: {
					Label: Ограничение чар вампиризма (влияние на стандартный лимит вампиризма) (%)
					Tooltip:
						'''
						Значение выше 100% усиливает ограничение вампиризма, ниже 100% — ослабляет. 0 убирает ограничение.
						В основной Terraria действует система ограничения вампиризма. Далее приведены значения обычного режима; значения эксперта/мастера указаны в скобках.
						Для вампиризма доступен запас 80(70). Лечение вампиризмом расходует этот запас.
						Каждую секунду запас восстанавливается на 36(30). Пока запас отрицателен, вампиризм не может лечить.
						Эта настройка определяет, насколько лечение от чар вампиризма расходует данный запас.
						Пример: 200%. Вы восстанавливаете 200 здоровья вампиризмом. 200 * 200% = 400. Запас 80(70) - 400 лечения = -320(-330) запаса.
						Чтобы запас снова стал положительным и вампиризм вновь мог лечить, потребуется 320/36(330/30) секунд -> 8.9(11) секунд.
						Примечание: механика не ограничивает разовое количество лечения. Чем больше вы восстановите сразу, тем дольше затем будет восстанавливаться запас.
						'''
				}

				AmaterasuSelfGrowthPerTick.Tooltip: Определяет, как быстро урон Аматэрасу растёт сам по себе (не касается повторных попаданий оружием с чарами «Мир в огне»).

				AutoReuseDisabledOnMagicMissile: {
					Label: Отключить автоповтор у оружия типа волшебной ракеты
					Tooltip: Автоповтор оружия вроде волшебной ракеты позволяет непрерывно выпускать снаряды и бесконечно накапливать урон.
				}

				InfusionDamageMultiplier.Tooltip:
					'''
					Меняет множитель урона от насыщения. DamageMultiplier = InfusionDamageMultiplier^((InfusionPower - BaseInfusionPower) / 100)
					Пример: железный палаш с уроном 10 и базовой силой насыщения 31 насыщается Мяумером с силой насыщения 1100.
					Урон железного палаша = 10 * 1.3^((1100 - 31) / 100) = 10 * 1.3^10.69 = 10 * 16.52 = 165 урона.
					Значение множителя 1000 запрещает насыщать оружие и убирает прибавку к урону у уже насыщенного оружия.
					'''
			}
		}

		GameMessages: {
			FailedConvertExcessExperience: Не удалось выполнить CheckConvertExcessExperience(item: {0}, consumedItem: {1})
			FailedToCloneItem: EnchantedItem: не удалось выполнить Clone(item: {0}, itemClone: {1}); cloneReforgedItem: {2}, resetGlobals: {3}.
			NonEnchantableItemInTable:
				'''
				В столе обнаружен предмет, который нельзя зачаровать: {0}.
				ВНИМАНИЕ: НЕ НАЖИМАЙТЕ «ПОДТВЕРДИТЬ».
				Сообщите об этой ошибке andro951 (Weapon Enchantments).
				'''
			PreventedIssueLooseExperience: Предотвращена ошибка, из-за которой мог уменьшиться ваш опыт. (xpInt < 0) item: {0}, target: {1}, hit: {2}, melee: {3}, Main.GameMode: {4}, target.defense: {5}, xpDamage: {6}, lowDamagePerHitXPBoost: {7}
		}
	}

