			FishHarvester: {
				DisplayName: Сборщик рыбы
				Tooltip:
					'''
					После установки ловит рыбу в воде поблизости.
					Требует бесконечную удочку или обычную удочку с наживкой.
					Некоторые предметы в сундуке повышают качество улова.
					Улов зависит от местоположения сундука и биома.
					Размещайте не выше 10 блоков над водой.
					Биом определяется в пределах 30 блоков в каждом направлении.
					'''
			}

			GemCornHarvester: {
				DisplayName: Сборщик самоцветных деревьев
				Tooltip:
