					Label: Фиксированный дополнительный опыт
				}

				AdditionalExpBeforeMult: {
					Label: Дополнительный опыт до множителей
					Tooltip: Дополнительный опыт до применения множителей и остальных настроек
				}

				PriceIncreasePercent: {
					Tooltip: Процентное увеличение стоимости до остальных расчётов: новая стоимость = старая стоимость + старая стоимость × указанный процент
					Label: Процент роста стоимости
				}

				AdditionalPrice: {
					Tooltip: Добавка к стоимости улучшения в опыте до остальных расчётов
					Label: Дополнительная стоимость
				}

				IncreaseBaseDamage: {
					Label: Увеличивать базовый урон
					Tooltip: Усиливает базовый урон оружия. На полученную прибавку также действуют бонусы брони и аксессуаров.
				}

				ExpForArmorMult: {
					Label: Множитель опыта брони
					Tooltip: Множитель получаемого бронёй опыта
				}

				AdditionalPriceFlat: {
					Label: Фиксированная добавка к стоимости
					Tooltip: Добавка к стоимости улучшения в опыте после остальных расчётов
				}

				IncreaseFlatDamage: {
					Label: Фиксированная прибавка урона
					Tooltip: Дополнительный урон после применения остальных бонусов
				}

				IncreaseMultDamage: {
					Label: Множитель дополнительного урона
					Tooltip: Дополнительный урон в процентах
				}

				FromDamagePercentArmor: {
					Tooltip: Урон преобразуется в опыт. Значение задаёт процент урона, превращаемый в опыт.
					Label: Процент опыта брони от урона
				}

				FromDamagePercentWeapon: {
					Tooltip: Урон преобразуется в опыт. Значение задаёт процент урона, превращаемый в опыт.
					Label: Процент опыта оружия от урона
				}

				ExpFromGettingHit: {
					Tooltip: Количество опыта за одно получение урона от врага
					Label: Опыт за полученный удар
				}

				ExpPerHit: {
					Tooltip: Количество опыта за одно нанесение урона врагу
					Label: Опыт за нанесённый удар
				}

				SocialAccessoriesRecieveExp: {
					Tooltip: Будут ли улучшаться аксессуары в декоративных ячейках?
					Label: Опыт аксессуаров в декоративных ячейках
				}

				AccessoriesRecieveExp: {
					Tooltip: Могут ли аксессуары получать прибавку защиты?
					Label: Аксессуары получают опыт
				}

				SocialArmorRecieveExp: {
					Tooltip: Будет ли улучшаться броня в декоративных ячейках?
					Label: Опыт брони в декоративных ячейках
				}

				ArmorRecieveExp: {
					Tooltip: Может ли броня получать прибавку защиты?
					Label: Броня получает опыт
				}

				WeaponRecieveExp: {
					Tooltip: Может ли оружие получать прибавку урона?
					Label: Оружие получает опыт
				}

				AccessoriesShouldHaveArmorToRecieveExp: {
					Tooltip: Требовать исходную защиту у аксессуара для её увеличения. Если выключено, защита будет добавляться всем аксессуарам.
					Label: Аксессуарам нужна защита для получения опыта
				}

				ArmorShouldHaveDefenseToRecieveExp: {
					Label: Броне нужна защита для получения опыта
					Tooltip: Требовать исходную защиту у брони для её увеличения. Если выключено, защита будет добавляться любой броне.
				}

				IgnoreDefence: {
					Label: Не учитывать защиту
					Tooltip: По умолчанию опыт брони зависит от фактически полученного урона. При высокой защите удар даёт мало опыта: чем опаснее бой, тем больше помощь мода. Если включено, опыт рассчитывается по исходному урону без учёта защиты и сопротивлений.
				}

				MinionSlotsReduce: {
					Tooltip: Эта настройка уменьшает стоимость миньонов в ячейках призыва, а не добавляет новые ячейки. Большинство миньонов занимают одну ячейку, а пауки — меньше одной. Для устойчивой работы желательно иметь хотя бы одну дополнительную ячейку. При значении «За уровень» = 1 оружие 25-го уровня уменьшает стоимость миньона на 25%. С настройками по умолчанию на 100-м уровне в то же число ячеек помещается вдвое больше миньонов.
					Label: Снижение стоимости миньонов в ячейках
				}

				AdditionalProjectileOnShootChance: {
					Tooltip: Настройка задаёт шанс дополнительных снарядов. При 250% выстрел создаёт два дополнительных снаряда и с вероятностью 50% — ещё один. Предел ограничивает шанс, а не число снарядов. В видео Necr0 использовал значение «Множитель за уровень» = 25.
					Label: Шанс дополнительного снаряда при выстреле
				}

				UseMinionDamageFix: {
					Label: Исправление урона миньонов
					Tooltip: Некоторое оружие не использует метод GetWeaponDamage, через который мод повышает урон. Настройка принудительно передаёт миньонам урон оружия. Если выключено, усиление урона у такого оружия может не работать.
				}

				UseMinionFix: {
					Tooltip: Некоторое оружие не использует метод GetWeaponDamage, через который мод повышает урон. Настройка принудительно передаёт миньонам урон оружия. Если выключено, усиление урона у такого оружия может не работать.
					Label: Исправление миньонов
				}

				ProjectileLifeTimeIncrement: {
					Label: Прирост времени жизни снаряда
					Tooltip: Эти настройки иногда нарушают поведение снарядов. Обычно всё работает, но снаряды, создаваемые другими снарядами — например стреляющими миньонами, — могут начать лететь вправо. Если заметите это, выключите настройку.
				}

				LocalImmunModeOnProj: {
					Label: Режим локальной неуязвимости снаряда
					Tooltip: Изменяет время неуязвимости НИПов после попадания ваших снарядов. Некоторые режимы позволяют каждому снаряду наносить урон независимо от остальных. Настройка сильно влияет на баланс: автор рекомендует выключить её, поставить 10 кадров либо подобрать значение самостоятельно.
				}
			}

