			UnlimitedShimmerArrows: {
				DisplayName: Бесконечные мерцающие стрелы
				Tooltip: Мерцающие стрелы никогда не закончатся.
			}

			ArenaBuilder: {
				DisplayName: Строитель платформ для арены
				Tooltip:
					'''
					Строит платформу шириной около 200 блоков.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки, материал платформы и дополнения.
					Автоматически использует асфальтовые платформы, если они есть в инвентаре.
					Выбор костра добавляет костры.
					Также размещает блоки пузырей для мёда.
					Выбор освещения освещает платформу по всей длине.
					Не разрушает блоки.
					'''
			}

			FishingBiomeBuilder: {
				DisplayName: Строитель биомов для рыбалки
				Tooltip:
					'''
					Строит биом для рыбалки.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Выберите обсидиан, чтобы разместить за блоками стены джунглей или грибные стены.
					Выберите дерево или камень для внешней ограды.
					Переключатель освещения позволяет включить или выключить свет.
					Жемчужный камень и освящённый лёд доступны только в сложном режиме.
					'''
			}

			FishingBuilder: {
				DisplayName: Строитель водоёмов
				Tooltip:
					'''
					Создаёт водоём для рыбалки или добавляет и убирает жидкость.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					При выключенном строительстве водоёма работает как совершенный манипулятор жидкостей.
					При включённом строительстве создаёт водоём с выбранной жидкостью.
					При выборе губки водоём будет пустым, без платформ и внешних блоков.
					При включённом обсидиане размещает фоновую стену, в том числе в режиме губки.
					'''
			}

			GroundFiller: {
				DisplayName: Жезл земли 2.0
				Tooltip:
					'''
					Щёлкните правой кнопкой мыши, чтобы сменить режим.
					Режим 1: выравнивает и заполняет землю под вами на 300 блоков в ширину и 50 в глубину.
					Режим 2: дополнительно расчищает 50 блоков сверху.
					Режим 3: также действует в темнице, храме и подземной пустыне, оставляя фоновые стены.
					Блоки из модов заменяются блоками основной игры.
					'''
			}

			Hellevator: {
				DisplayName: Автоматическая шахта в ад
				Tooltip:
					'''
					Строит шахту в ад.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Если включён свет, шахта освещается по всей глубине.
					Размещает верёвку только при наличии одного из предметов бесконечной верёвки в инвентаре.
					Щёлкните в месте верхнего правого блока стены шахты.
					Останавливается при столкновении с храмом.
					'''
			}

			PrisonBuilder: {
				DisplayName: Строитель тюрем
				Tooltip:
					'''
					Строит тюрьму для НИП.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Освещается при включённом свете; в любом случае считается жильём.
					Щёлкните в месте нижнего правого блока.
					'''
			}

			SkyPlatformBuilder: {
				DisplayName: Строитель небесных мостов
				Tooltip:
					'''
					Строит платформу через всю карту.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Если включён свет, платформа освещается по всей длине.
					Не разрушает блоки.
					Автоматически использует асфальтовые платформы, если они есть в инвентаре.
					'''
			}

			SubAndSky: {
				DisplayName: Строитель рельсов и платформ
				Tooltip:
					'''
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Если включён свет, путь освещается по всей длине.
					Материалом платформ может быть обсидиан, имеющий приоритет, или разные виды древесины.
					При наличии бесконечных асфальтовых платформ в инвентаре размещает их вместо выбранного материала.
					При выборе обсидиана рельсы прокладываются без стен и пола.
					Установка платформ разрушает блоки.
					Щёлкните там, где должны проходить рельсы или платформа.
					Проходит через храм, если Голем побеждён.
					'''
			}

			SubwayBuilder: {
				DisplayName: Строитель метро
				Tooltip:
					'''
					Строит метро.
					Щёлкните правой кнопкой мыши, чтобы выбрать настройки.
					Если включён свет, путь освещается по всей длине.
					Щёлкните там, где должны проходить рельсы.
					Проходит через храм, если Голем побеждён.
					'''
			}

			InstantMoonLord: {
				DisplayName: Мгновенный призыв Лунного лорда
				Tooltip: Пропускает ожидание надвигающегося рока.
			}

			NoAltarGolem: {
				DisplayName: Призыв Голема
				Tooltip:
					'''
					Призывает Голема без алтаря ящеров.
					Можно использовать только после победы над Големом.
					'''
			}

			NoFishDuke: {
				DisplayName: Призыв Рыброна
				Tooltip: Призывает Рыброна без рыбалки.
			}

			WallSummon: {
				DisplayName: Окровавленная кукла вуду гида
				Tooltip:
					'''
					Призывает Стену плоти без гида.
					Можно использовать только после победы над Стеной плоти.
					'''
			}

			MultiPurposeSponge: {
				DisplayName: Универсальная губка
				Tooltip:
					'''
					Избавьтесь от всей этой жидкости.
					Действует на воду, лаву и мёд.
					'''
			}

			UltimateBucket: {
				DisplayName: Совершенный манипулятор жидкостей
				Tooltip:
					'''
					Жидкость никогда не закончится.
					Если только вы сами этого не захотите.
					Щёлкните правой кнопкой мыши, чтобы сменить режим.
					'''
			}

			UnlimitedChumBucket: {
				DisplayName: Бесконечное ведро прикормки
