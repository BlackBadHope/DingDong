					'''
			}

			EnemyHarvester: {
				DisplayName: Сборщик добычи врагов
				Tooltip:
					'''
					После установки собирает добычу врагов в зависимости от обнаруженного биома.
					Учитывает биом блоков, на которых установлен, поэтому,
					если поставить его на 2 блока жемчужного камня, он определит
					биом как Освящение.
					Не собирает деньги и выпадающую еду.
