	AnglerArmorBonus: {
		Configs: {
			ServerConfig: {
				DisplayName: Серверные настройки

				extraFishingLines: {
					Label: Дополнительные лески
					Tooltip: Число дополнительных лесок от бонуса полного комплекта рыбацкой брони.
				}

				doubleCatchChance: {
					Label: Шанс двойного улова
					Tooltip: Шанс получить вдвое больше обычного улова с каждой лески.
				}

				tripleCatchChance: {
					Label: Шанс тройного улова
					Tooltip:
						'''
						Шанс получить втрое больше обычного улова с каждой лески.
						Проверяется только после успешного срабатывания двойного улова.
						'''
				}

				maxStackLimit: {
					Label: Соблюдать предел стопки
					Tooltip:
						'''
						Двойной и тройной улов не превышают допустимый размер стопки предмета.
						Например, тройной улов лягушачьих лапок без этой настройки даёт стопку из трёх предметов.
						С этой настройкой размер такой стопки ограничивается одним предметом.
						'''
				}
			}
		}
	}

