				Tooltip: Особенно эффективна против боссов!
			}

			HardTriadBattlerod: {
				DisplayName: Боевая удочка твёрдой триады
				Tooltip:
					'''
					Хороша против боссов, но ещё лучше против обычных врагов
					В жидкости создаёт торнадо и накладывает ледяное пламя
					'''
			}

			LifeforceBattlerod: {
				DisplayName: Боевая удочка жизненной силы
				Tooltip:
					'''
					Вытягивает жизненную силу из противника
					На удивление быстрая
					'''
			}

			OrichalcumBattlerod: {
				DisplayName: Орихалковая боевая удочка
				Tooltip: Какая красота!
			}

			ShroomiteBattlerod: {
				DisplayName: Грибнитовая боевая удочка
				Tooltip:
					'''
					Во время ожидания распространяет грибы
					На удивление быстрая
					'''
			}

			SlimeQueenBattlerod: {
				DisplayName: Боевая удочка Королевы слизней
				Tooltip: Склизкая!
			}

			SpectreBattlerod: {
				DisplayName: Спектральная боевая удочка
				Tooltip:
					'''
					Во время ожидания выпускает магнитные сферы
					Немного похищает здоровье
					'''
			}

			SpinyTurtleBattlerod: {
				DisplayName: Боевая удочка шипастой черепахи
				Tooltip:
					'''
					Пока поплавок прикреплён к врагу, отражает двойной урон
					Изначально обладает свойством умных поплавков!
					'''
			}

			SpookyBattlerod: {
				DisplayName: Жуткая боевая удочка
				Tooltip: Стреляет летучими мышами
			}

			TerraBattlerod: {
				DisplayName: Боевая удочка Терры
				Tooltip:
					'''
					Легендарная удочка
					Во время ожидания выпускает лезвия
					'''
			}

			TurtleBattlerod: {
				DisplayName: Черепашья боевая удочка
				Tooltip: Пока поплавок прикреплён к врагу, отражает весь урон
			}

			BeeBattlerod: {
				DisplayName: Пчелиная боевая удочка
				Tooltip: Столько пчёл!
			}

			CactusBattlerod: {
				DisplayName: Кактусовая боевая удочка
				Tooltip: Колючая!
			}

			CoolerBattlerod: {
				DisplayName: Боевая удочка Морозника
				Tooltip:
					'''
					Позволяет одновременно использовать 3 разные усиленные наживки
					Почти не наносит урона
					'''
			}

			CorruptBattlerod: {
				DisplayName: Искажённая боевая удочка
				Tooltip: Совсем немного поглощает ману
			}

			CrimsonBattlerod: {
				DisplayName: Багряная боевая удочка
				Tooltip: Совсем немного похищает здоровье
			}

			DeerclopsBattlerod: {
				DisplayName: Боевая удочка Циклопа-оленя
				Tooltip:
					'''
					Создаёт две тени
					Позволяет одновременно использовать 2 разные усиленные наживки
					'''
			}

			DungeonBattlerod: {
				DisplayName: Боевая удочка Темницы
				Tooltip: Кажется, за мной наблюдают...
			}

			GoldBattlerod: {
				DisplayName: Золотая боевая удочка
				Tooltip:
					'''
					Не та самая золотая удочка...
					Слышите звон падающих монет?
					'''
			}

			HellstoneBattlerod: {
				DisplayName: Боевая удочка из адского камня
				Tooltip:
					'''
					Поджигает врагов!
					Позволяет рыбачить в лаве
					'''
			}

			JungleBattlerod: {
				DisplayName: Боевая удочка джунглей
				Tooltip: Отравляет врагов
			}

			MeteorBattlerod: {
				DisplayName: Метеоритная боевая удочка
				Tooltip: Поджигает врагов!
			}

			SilverBattlerod: {
				DisplayName: Серебряная боевая удочка
				Tooltip: Особенно эффективна против оборотней
			}

			StarMixBattlerod: {
				DisplayName: Боевая удочка звёздного сплава
				Tooltip: Удваивает урон по боссам
			}

			FractaliteBattlerod: {
				DisplayName: Фракталитовая боевая удочка
				Tooltip:
					'''
					Создаёт область, накладывающую солнечное пламя на врагов
					Очень мощная!
					Стреляет самонаводящимися пулями
					'''
			}

			NebulaBattlerod: {
				DisplayName: Боевая удочка туманности
				Tooltip: В жидкости выпускает полезные предметы для подбора
			}

			PowerGuardBattlerod: {
				DisplayName: Боевая удочка могучего стража
				Tooltip:
					'''
					Пока поплавок прикреплён к врагу, отражает тройной урон
					Изначально обладает свойством умных поплавков!
					Выпускает пылающих взрывающихся жуков
					'''
			}

			RegalSistersBattlerod: {
				DisplayName: Боевая удочка царственных сестёр
				Tooltip:
					'''
					Россыпь самонаводящихся снарядов!
					Прекрасно подходит для рыбалки!
					'''
			}

			RodContainmentUnit: {
				DisplayName: Блок сдерживания удочек
				Tooltip:
					'''
					Венец боевых удочек!
					Создаёт вокруг поплавка большую область, наносящую урон всем врагам внутри
					'''
			}

			SolarBattlerod: {
				DisplayName: Солнечная боевая удочка
				Tooltip:
					'''
					Создаёт область, накладывающую солнечное пламя на врагов
					Очень мощная!
					Позволяет рыбачить в лаве
					'''
			}

			StardustBattlerod: {
				DisplayName: Боевая удочка звёздной пыли
				Tooltip:
					'''
					При взмахе создаёт двух миньонов — клетки звёздной пыли
					Прекрасно подходит для рыбалки!
					'''
			}

			VortexBattlerod: {
				DisplayName: Вихревая боевая удочка
				Tooltip:
					'''
					Стреляет самонаводящимися пулями
					Очень быстрая!
					'''
			}

			BeerPack: {
				DisplayName: Упаковка пива
				Tooltip: Уже не такое холодное
			}

			IceCreamer: {
				DisplayName: Мороженщик
				Tooltip: Стреляет одним из четырёх вкусов!
			}

			MagicSoda: {
				DisplayName: Волшебная газировка
				Tooltip: Встряхните и распылите! Обычно урон уменьшается с расстоянием.
			}

			Melonbrand: {
				DisplayName: Дынный клинок
				Tooltip: При взмахе бросает ломтики дыни
			}
		}

