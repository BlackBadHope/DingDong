		Configs: {
			FishermanNPCConfigServer: {
				DisplayName: Серверные настройки Рыбака

				SellModdedItems: {
					Label: "[i:3122]   Продавать предметы мода Fisherman NPC"
					Tooltip:
						'''
						Определяет, продаёт ли Рыбак предметы этого мода.
						При включении они доступны в магазине; при выключении — отсутствуют.
						По умолчанию: включено
						'''
				}

				SellBait: {
					Label: "[i:2002]   Продавать наживку"
					Tooltip:
						'''
						Определяет, продаёт ли Рыбак наживку.
						При включении наживка доступна в магазине; при выключении — отсутствует.
						По умолчанию: включено
						'''
				}

				SellFish: {
					Label: "[i:2290]   Продавать рыбу"
					Tooltip:
						'''
						Определяет, продаёт ли Рыбак рыбу.
						При включении рыба доступна в магазине; при выключении — отсутствует.
						По умолчанию: включено
						'''
				}

				SellFishingRods: {
					Label: "[i:2291]   Продавать удочки"
					Tooltip:
						'''
						Определяет, продаёт ли Рыбак удочки.
						При включении удочки доступны в магазине; при выключении — отсутствуют.
						По умолчанию: включено
						'''
				}

				SellExtraItems: {
					Label: "[i:3120]   Продавать дополнительные предметы"
					Tooltip:
						'''
						Определяет, продаёт ли Рыбак рыболовные аксессуары, части рыбоискателя и декоративные предметы.
						При включении они доступны в магазине; при выключении — отсутствуют.
						По умолчанию: включено
						'''
				}

				ShopPriceScaling: {
					Label: "[i:87]   Масштаб цен магазина"
					Tooltip:
						'''
						Изменяет цены в магазине Рыбака.
						50 — половина обычной цены, 200 — двойная цена.
						Уменьшите значение, чтобы сделать товары дешевле, или увеличьте, чтобы сделать дороже.
						По умолчанию: 100
						'''
				}

				TownNPCsCrossModSupport: {
					Label: "[i:3121]   Совместимость Рыбака с другими модами"
					Tooltip:
						'''
						Разрешает Рыбаку продавать предметы других модов, использовать связанные с ними реплики и учитывать их жителей при расчёте счастья.
						При выключении такие товары и реплики отсутствуют.
						По умолчанию: включено
						Для изменения реплик и товаров перезагрузка не нужна.
						Для изменения предпочтений счастья требуется перезагрузка модов.
						'''
				}

				CatchNPCs: {
					Label: "[i:1991]   Ловить Рыбака"
					Tooltip:
						'''
						Позволяет поймать Рыбака сачком, как жителей в Fargo's Mutant Mod.
						При выключении поймать его нельзя.
						По умолчанию: выключено
						Требуется перезагрузка модов.
						'''
				}

				LoadDebugItems: {
					Label: "[i:784]   Загружать отладочные предметы"
					Tooltip:
						'''
						Определяет, загружаются ли отладочные предметы.
						Сейчас настройка влияет на переключатель заданий рыбака.
						По умолчанию: выключено
						Требуется перезагрузка модов.
						'''
				}

				Headers.ServerHeader: "[c/00FF00:Серверные настройки]"
				MultiplayerMessage: Вы не владелец сервера и не можете менять эту настройку!
			}
		}

		Common: {
			Forest: Лес
			Ocean: Океан
			Desert: Пустыня
			None: Нет
