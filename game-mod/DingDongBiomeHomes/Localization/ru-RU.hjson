	SilkyUIFramework: {
		Configs: {
			SilkyUIClientConfig: {
				DeathTextOffset: {
					Tooltip: ""
					Label: Смещение текста смерти
				}

				MouseTextOffset: {
					Tooltip: ""
					Label: Смещение текста у курсора
				}

				DisplayName: "{$Mods.ThoriumMod.Configs.ThoriumConfigClient.DisplayName}"

				EnableBlur: {
					Label: Включить размытие (не работает в режиме «Ретро»)
					Tooltip: "Для экранов высокого разрешения рекомендуется увеличить знаменатель масштаба.  "
				}

				SingleBlur: {
					Label: Независимое размытие окон
					Tooltip: Каждый элемент интерфейса размывается отдельно для лучшего эффекта, но возможны проблемы совместимости.
				}

				BlurZoomMultiplierDenominator: {
					Label: Знаменатель масштаба (выше — меньше нагрузка)
					Tooltip:
						'''
						Чем больше значение, тем меньше обрабатываемое изображение.  
						При замедлениях попробуйте увеличить значение.  
						Для обычных видеокарт при разрешении 4K рекомендуется 4.  
						Для мощных видеокарт можно сразу выбрать 1.  
						При значении 1 обработка идёт в исходном разрешении.  
						Уменьшение значения влияет на область размытия, поэтому ниже могут понадобиться поправки.  
						'''
				}

				BlurIterationCount: {
					Label: Количество проходов (выше — больше нагрузка)
					Tooltip:
						'''
						Чем больше значение, тем чаще применяется размытие и тем сильнее результат.  
						При замедлениях попробуйте уменьшить значение.  
						'''
				}

				IterationOffsetMultiplier: {
					Label: Множитель смещения выборки (не влияет на производительность)
					Tooltip: Большие значения усиливают размытие, но могут создавать полосы.
				}

				BlurMixingNumber: {
					Label: Количество смешиваемых цветов (выше — больше нагрузка)
					Tooltip: Большие значения увеличивают число образцов цвета.
				}
			}

			BlurMixingNumber: {
				Tooltip: ""

				One: {
					Tooltip: ""
					Label: Один
				}

				Two: {
					Tooltip: ""
					Label: Два
				}

				Three: {
					Tooltip: ""
					Label: Три
				}

				Four: {
					Tooltip: ""
					Label: Четыре
				}

				Five: {
					Tooltip: ""
					Label: Пять
				}
			}
		}
	}

