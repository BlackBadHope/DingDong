			}

			SkeletonMerchant: {
				DisplayName: "{$NPCName.SkeletonMerchant}"

				TownNPCMood: {
					Content: Спасибо, что пока не убиваешь меня, я очень это ценю ^^
					NoHome: Знаешь, я тоже хотел бы иметь дом :(
					LoveSpace: Здесь столько места: можно упражняться с йо-йо и метать кости... Не рискуя выбить кому-нибудь глаз.
					FarFromHome: Поможешь мне найти дорогу домой? Понимаешь, я скелет и не вижу, куда иду...
					DislikeCrowded: Большая вечеринка? Сколько народу...
					HateCrowded: Ого, вокруг меня слишком много людей... Ненавижу это.
					LikeBiome: А ещё мне нравится лес: здесь совсем не так, как внизу. Наконец-то можно подышать свежим воздухом!
					LoveBiome: А ещё я очень люблю подземелья. Там я чувствую себя как дома!
					DislikeBiome: И ещё один вопрос: ЗАЧЕМ Я ЗДЕСЬ?!
					HateBiome: Сложновато делать моды, когда на тебя нападают монстры в биоме {BiomeName}.
					LikeNPC: Я поговорил с {NPCName}, отличный человек!
					LoveNPC: Поговорил с {NPCName}... Он любит всё взрывать, я тоже. Мы просто созданы друг для друга!
					HateNPC: М-м-м, товарищ искатель приключений, тут есть девушка по имени {NPCName}, которая хочет меня очистить... Мне это не нравится: она хочет ставить на мне опыты... ПОМОГИ!
					LikeNPC_Princess: Мне нравится {NPCName}.
					Princess_LovesNPC: Мне нравится {NPCName}.
				}

				Census.SpawnCondition: Победите любых 50 скелетов
			}

			TravellingMerchant: {
				DisplayName: "{$NPCName.TravellingMerchant}"

				TownNPCMood: {
					Content: Эй! Сегодня ищешь что-нибудь купить?
					NoHome: Знаешь, я тоже хотел бы иметь дом :(
					LoveSpace: Ах, сколько места! Теперь можно подумать о торговле!
					FarFromHome: На помощь! Я не могу найти дорогу домой. Пожалуйста, отведи меня обратно.
					DislikeCrowded: Кажется, здесь немного многовато покупателей, а?
					HateCrowded: У меня вообще-то ограниченный запас товара... На всех не хватит, дайте мне немного места...
					LikeBiome: Да, пустыня хороша. Люблю здешние виды и... О, покупатель!
					LoveBiome: Ах, лес... Тихое и спокойное место для жизни, да ещё и покупателей полно!
					HateBiome: А ещё у меня вопрос... Что я вообще должен здесь делать... Серьёзно, тут слишком опасно, и никто не станет покупать мой товар. Ненавижу это место.
					LikeNPC: У {NPCName} настоящая душа торговца. Мне это нравится!
					LoveNPC: О, вон {NPCName}... О нет, я опять краснею?
					HateNPC: Пожалуйста, можно жить без {NPCName} по соседству? Он вытягивает из меня все сбережения...
					LikeNPC_Princess: Мне нравится {NPCName}.
					Princess_LovesNPC: Мне нравится {NPCName}.
				}

				Census.SpawnCondition: Носите с собой 50 золотых монет
			}

			TargetDummy: {
				DisplayName: "{$NPCName.TargetDummy}"

				TownNPCMood: {
					Content: Я доволен.
					NoHome: Ненавижу жить без дома.
					FarFromHome: Я слишком далеко от дома.
					LoveSpace: Люблю, когда столько свободного места.
					DislikeCrowded: Мне не нравится эта теснота.
					HateCrowded: Ненавижу эту тесноту.
					LikeNPC_Princess: Мне нравится {NPCName}.
					Princess_LovesNPC: Мне нравится {NPCName}.
				}
			}

			MobileMerchant: {
				DisplayName: Передвижной торговец

				TownNPCMood: {
					Content: Привет, приятно с тобой поболтать ^^
					NoHome: Не понимаю этой тяги к собственному дому: я всего лишь парящий на месте торговец...
					FarFromHome: А? Нет, мне не нужен дом.
					LoveSpace: Здесь столько места для меня и друзей, спасибо ^^
					DislikeCrowded: Здесь что, вечеринка? Народу немного многовато.
					HateCrowded: Здесь слишком много народу, пожалуйста, попроси их уйти.
					LikeNPC_Princess: Мне нравится {NPCName}.
					Princess_LovesNPC: Мне нравится {NPCName}.
				}

				Chat: Поторопись, я не могу задерживаться надолго...
			}
		}

