		Configs: {
			CalValEXConfig: {
				DisplayName: Настройки

				DisableVanityDrops: {
					Label: Отключить всю добычу
					Tooltip: Отключает все прямые выпадения предметов мода
				}

				ConfigBossBlocks: {
					Label: Отключить выпадение блоков с боссов
					Tooltip: Боссы и их мешки больше не дают блоки
				}

				FatDog: {
					Label: Истинный размер
					Tooltip: При включении делает одного из питомцев гораздо крупнее
				}

				SupCombo: {
					Label: Парад суеверных духов
					Tooltip: Позволяет Суеверному самоцвету призывать 11 питомцев, предметы которых входят в его рецепт
				}

				DragonballName: {
					Label: Отключить пасхалку Драконьего шара
					Tooltip: Отключает пасхалку, которую вызывает питомец Драконий шар
				}

				Polterskin: {
					Label: Отключить облики игрушечной косы
					Tooltip: Питомец игрушечной косы всегда использует стандартный облик
				}

				Pitbul: {
					Label: Отключить лай питбуля
					Tooltip: Питомец-питбуль перестаёт лаять на редких врагов
				}

				Headers.NPCs: НИПы

				TownNPC: {
					Label: Отключить городских НИПов
					Tooltip: Не позволяет Оракулу и Жрице медуз появляться
				}

				IsopodBait: {
					Label: Отключить рост силы наживки изопода
					Tooltip: Сила наживки глубинных изоподов всегда максимальна
				}

				CritterSpawns: {
					Label: Отключить появление зверьков
					Tooltip: Все зверьки Calamity's Vanities перестают появляться естественным образом
				}

				GroundMountLol: {
					Label: Отключить ослабление ездовых существ
					Tooltip: Отключает снижение характеристик от наземных ездовых существ
				}

				DiscordRichPresence: {
					Label: Discord Rich Presence ([c/ffa11:Требуется мод DRP!])
					Tooltip:
						'''
						Включает дополнения к моду Discord Rich Presence от Purplefin Neptuna.
						Работает только при включённом моде Discord Rich Presence.
						'''
				}

				OwnerOnly: {
					Label: Разрешить доступ к настройкам только владельцу сервера
					Tooltip:
						'''
						Рекомендуется для режима «Создать и играть» и сервера на том же компьютере, где вы играете.
						Если выключено, настройки могут менять все пользователи
						'''
				}

				HerosPerm: {
					Label: Разрешить изменение настроек через систему прав Hero's Mod
					Tooltip:
						'''
						Для тех, кто использует Hero's Mod в сетевой игре.
						Если выключено, настройки могут менять все пользователи
						'''
				}

				AprilFoolsContent: {
					Label: Первоапрельское содержимое
					Tooltip: При выключении отключает первоапрельское содержимое
				}

				UseFables: {
					Label: Использовать содержимое Calamity Fables
					Tooltip:
						'''
						Если включён мод Calamity Fables, приоритет получают его аналоги.
						Например, добыча Calamity's Vanities с Бича пустыни будет выпадать с Бича пустыни из Calamity Fables, а не из Calamity.
						Выключите, чтобы приоритет получали аналоги из Calamity.
						'''
				}
			}

			ChangeGood: Ваши изменения приняты.
			HostOnly: Менять настройки может только владелец сервера.
			NoPerms: У вас нет необходимого разрешения.
			Drops: Добыча
			Pets: Питомцы
			Gameplay: Игровой процесс
			OtherHeader: Прочее
		}

