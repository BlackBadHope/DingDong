				DisplayName: Плащ червей
				Tooltip: При ходьбе появляются черви. Трюфельные черви больше не убегают от вас.
			}

			BaitDisperser: {
				DisplayName: Распылитель наживки
				Tooltip: Накладывает отрицательные эффекты используемой наживки на всех врагов в радиусе 8 блоков
			}

			BarbedHook: {
				DisplayName: Крючок с бородкой
				Tooltip: Увеличивает шанс критического удара удочки на 10%
			}

			CrateCallingHook: {
				DisplayName: Крючок искателя ящиков
				Tooltip: При убийстве врага есть 5% шанс получить ящик. Его вид зависит от используемой удочки.
			}

			CurrencyHook: {
				DisplayName: Денежный крючок
				Tooltip: После удара поплавка прикреплённый враг с вероятностью 0,5% роняет деньги. Вид монет зависит от прогресса игры.
			}

			HeavenlyHook: {
				DisplayName: Небесный крючок
				Tooltip: Увеличивает урон удочки в зависимости от высоты игрока
			}

			RetractableHook: {
				DisplayName: Возвратный крючок
				Tooltip: Позволяет поплавку атаковать при возвращении к вам!
			}

			RustyHook: {
				DisplayName: Ржавый крючок
				Tooltip: Увеличивает урон удочки по врагам под водой
			}

			SealedHook: {
				DisplayName: Ослабляющий крючок
