						Уровень сложности, на котором доступны сборщики.
						Варианты: «Отключены», «Обычный и выше», «Эксперт и выше» и «Мастер и выше».
						По умолчанию: «Эксперт и выше»
						'''
				}

				potionsEnable: {
					Label: Бесконечные зелья
					Tooltip:
						'''
						Включает или выключает бесконечные зелья.
						При отключении предмет в инвентаре не даёт усиления.
						Стопки из 30 и более зелий основной игры также не дают усиления.
						По умолчанию включено
						'''
				}

				vanillaPotionsEnable: {
					Label: Автоматическое применение обычных зелий
					Tooltip:
						'''
						Автоматически применяет зелья основной игры, если в стопке 30 или более штук.
						Варианты: «Отключено», «Всегда» и «При наличии одного бесконечного зелья».
						По умолчанию: «При наличии одного бесконечного зелья»
						'''
				}

				PaperAmountForScrollCrafting: {
					Label: Количество бумаги для создания
					Tooltip:
						'''
						Количество бумаги, необходимое для создания свитка.
						При значении 0 бумага не требуется.
						По умолчанию: 5.
						'''
				}

				ultimateBattlerTimer: {
					Label: Таймер совершенной силы битвы
					Tooltip:
						'''
						Определяет, действует ли задержка в 5 секунд перед включением усиления совершенной силы битвы, перед его отключением или таймер отключён.
						Варианты: «Отключён», «Перед включением» и «После включения».
						По умолчанию: «Перед включением»
						'''
				}

				manaEnable: {
					Label: Бесконечная мана [i:{0}] [i:{1}] [i:{2}] [i:{3}] [i:{4}] [i:{5}]
					Tooltip:
						'''
						Включает или выключает бесконечную ману.
						При отключении предмет в инвентаре не даёт усиления.
						По умолчанию включено
						'''
				}

				superTools: {
					Label: Суперинструменты [i:{0}] [i:{1}] [i:{2}]
					Tooltip:
						'''
						Включает или выключает «Копай быстрее», «Время инструментов» и «Обустройство дома».
						При отключении предмет в инвентаре не даёт усиления.
						По умолчанию включено
						'''
				}

				boneEnable: {
					Label: Появление скелета-торговца как жителя
					Tooltip:
						'''
						Разрешает или запрещает появление скелета-торговца.
						Уже появившийся скелет-торговец, поселившийся в городе, не удаляется.
						По умолчанию включено
						'''
				}

				merchantEnable: {
					Label: Появление странствующего торговца как жителя
					Tooltip:
						'''
						Разрешает или запрещает появление странствующего торговца как жителя.
						Уже появившийся странствующий торговец, поселившийся в городе, не удаляется.
						По умолчанию включено
						'''
				}

				builderEnable: {
					Label: Автоматические строители [i:{0}]
					Tooltip:
						'''
						Разрешает получение и использование строительных предметов и инструментов.
						По умолчанию включено
						'''
				}

				worldRemoverEnable: {
					Label: Улучшенная буровая установка [i:{0}]
					Tooltip:
						'''
						Разрешает получение и использование улучшенной буровой установки.
						По умолчанию включено
						'''
				}

				moneyEnable: {
					Label: Сборщик монет [i:{0}]
					Tooltip:
						'''
						Разрешает получение и использование сборщика монет.
						По умолчанию включено
						'''
				}

				killerEnable: {
					Label: Бесконечный убийца торговцев [i:{0}]
					Tooltip:
						'''
						Разрешает получение и использование бесконечного убийцы торговцев.
						По умолчанию включено
						'''
				}

				magnetEnable: {
					Label: Магнит добычи [i:{0}]
					Tooltip:
						'''
						Разрешает получение и использование магнита добычи.
						По умолчанию включено
						'''
				}

				neededQuests: {
					Label: Дополнительные поплавки
					Tooltip:
						'''
						Сколько заданий рыбака требуется за каждый дополнительный поплавок.
						Значение 0 отключает эту возможность.
						Допустимые значения: от 0 до 100.
						По умолчанию: 5 заданий
						'''
				}

				rangerAmmo: {
					Label: Бесконечные боеприпасы дальнего боя
					Tooltip:
						'''
						Сколько боеприпасов дальнего боя нужно, чтобы они перестали расходоваться.
						Значение 0 отключает эту возможность.
						Допустимые значения: от 0 до 10000.
						По умолчанию: 3996
						'''
				}

				thrownAmmo: {
					Label: Бесконечные метательные боеприпасы
					Tooltip:
						'''
						Сколько метательных боеприпасов нужно, чтобы они перестали расходоваться.
						Значение 0 отключает эту возможность.
						Допустимые значения: от 0 до 10000.
						По умолчанию: 999
						'''
				}
			}
		}

