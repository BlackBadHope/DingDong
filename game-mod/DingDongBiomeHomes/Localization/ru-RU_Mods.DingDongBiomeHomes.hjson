MobRelics: {
	ClassicCondition: Только классический мир
	ExactExpertCondition: Только мир эксперта (не мастер)
	ExactMasterCondition: Только мир мастера (не легендарный)
	LegendaryCondition: Легендарный мир (режим мастера и «Для достойных»)

	Mechanics: {
		UniqueDrop: "{0}. Уникальная добыча с {1} из мода {2}."

		Availability: {
			CommonTrace: Обычная случайная добыча
			CommonCurio: Обычная случайная добыча
			ExpertSeal: Только пул мира эксперта
			MasterRelic: Только пул мира мастера
			LegendaryMyth: Только легендарный мир
		}

		Effect: {
			CommonTrace: Экипируемая реликвия охотника: +{0} ко всему урону и +{1}% к шансу критического удара.
