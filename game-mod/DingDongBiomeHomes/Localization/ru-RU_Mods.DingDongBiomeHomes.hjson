			Yes: да
			No: нет
			None: нет
		}

		Navigation: {
			Previous: < Назад
			Next: Далее >
			Page: "{0} / {1}"
		}

		Axes: {
			Delivery: способ доставки
			Element: стихия
			Behavior: схема атаки
			Acquisition: происхождение
			Segment: часть тела
			Phase: фаза боя
		}

		Coverage: {
			Explicit: явно заданный профиль
			Inherited: унаследовано от породившей атаки
			Adapter: автоматически распознано содержимое мода
			Fallback: автоматически распознано содержимое Terraria
			Unknown: неизвестно
		}

		Archetypes: {
			Slime: желатиновый
			Organic: органический
			Armored: бронированный
			Undead: нежить
			Plant: растительный
			Aquatic: водный
			Spectral: призрачный
			Mechanical: механический
			Unknown: особый
		}

		Difficulty: {
			Classic: Классика
			Expert: Эксперт
			Master: Мастер
			Legendary: Легендарная (Мастер + Достойный)
			Journey: Путешествие
			ForTheWorthy: активен сид «Достойный»
			StandardSeed: сид «Достойный» не активен
			NoCustomMode: особая сложность не активна
			NoExtraToggles: дополнительных режимов нет
			CompatibilityUnavailable: состояние режима недоступно
			WorldNotLoaded: адаптер загружен
			WorldNotLoadedDetail: Зависящее от мира состояние будет прочитано после окончания загрузки мира.
			CalamityDetail: Активные флаги: {0}. Сообщаемый масштаб сложности: ×{1}; это только отображение.
			CalamityDetailNoScale: Активные флаги: {0}.
			FargoDetail: Слой ванильного поведения Eternity: {0}.
			Enabled: включён
			Disabled: отключён
		}

		Pages: {
			Overview: {
				Title: Справочник урона
				Subtitle: Единое понятное место для типов оружия, особенностей врагов, отклика попаданий и сложности.
				StatusTitle: Текущее состояние
				StatusBody: Серверно-авторитетный слой урона DingDong: {0}. На сервере для каждого игрока действует одно и то же решение сервера.
				FormulaTitle: Что меняет попадание
				FormulaBody: Terraria и моды сложности считают базовый урон и защиту. DingDong применяет только совпавшие особенности врага и ограничивает свой множитель диапазоном ×0,80–×1,30.
				ActiveTitle: Оси, которые сейчас реально влияют
				ActiveBody: В загруженных профилях врагов ненейтральные правила сейчас есть для: {0}. Остальные показанные оси — честные описания, пока профиль врага явно не задаст для них правило.
				FeedbackTitle: Как читать отклик боя
				FeedbackBody: Оранжевая «Уязвимость» означает не менее ×1,075. Синее «Сопротивление» — не более ×0,925. Промежуточные попадания считаются нейтральными и не засоряют боевой текст.
				NoHiddenTitle: Без скрытых комбо и удаления кадров неуязвимости
				NoHiddenBody: Быстрые атаки не наращивают урон тайно, не снимают кадры неуязвимости и не запускают незаявленное комбо. Справочник и страница последнего попадания показывают каждый реально участвовавший множитель DingDong.
				RulesTitle: Главное правило
				RulesBody: Реально активные оси: {0}. Нейтральные удары не засоряют экран. DingDong не снимает кадры неуязвимости, не создаёт скрытое комбо и не меняет здоровье NPC вне серверного расчёта.
			}

			CurrentWeapon: {
				Title: Текущее оружие
				Subtitle: Оружие в руках анализируется тем же классификатором, который используется в бою.
				EmptyTitle: Уронное оружие не выбрано
				EmptyBody: Закройте справочник, возьмите в руки оружие и откройте снова. Подсказка предмета всегда показывает способ доставки, стихию и схему атаки.
				ReadTitle: Быстрый порядок чтения
				ReadBody: Способ доставки + стихия могут совпасть с профилем врага. Схема и происхождение показаны, чтобы правило никогда не стало скрытым, если будущий профиль начнёт их использовать.
				IdentityBody:
					'''
					Способ доставки: {0}
					Стихия: {1}
					'''
				PatternTitle: Схема атаки
				PatternBody: "{0}. Она описывает поведение атаки и сама по себе не является бонусом или дебаффом."
				OriginTitle: Происхождение
				OriginBody: "{0}. Происхождение — метаданные; оно меняет урон только если профиль врага явно содержит такое правило."
				CoverageTitle: Источник классификации
				CoverageBody: "{0}. Оружие из модов распознаётся без жёсткой зависимости от сборки его мода."
				ExpectTitle: Ожидаемый диапазон
				ExpectBody: Для изученного врага смотрите Бестиарий. Вклад DingDong в попадание не может быть меньше ×0,80 или больше ×1,30.
			}

			LastHit: {
				Title: Разбор последнего попадания
				Subtitle: Локальная квитанция последнего попадания предметом или снарядом, которое оценил DingDong.
				EmptyTitle: Попаданий ещё не записано
				EmptyBody: Ударьте враждебное существо предметом или снарядом и снова откройте страницу. Нейтральные попадания записываются сюда, даже если всплывающего текста нет.
				FeedbackTitle: Зачем нужна эта страница
				FeedbackBody: Она отличает «мод не сработал» от настоящего нейтрального результата ×1,00 и показывает, какой фактор изменил удар.
				ResultBody:
					'''
					Результат: {0}
					Итоговый множитель DingDong: ×{1}
					Самый сильный совпавший тег: {2}
					'''
				BreakdownTitle: Точный разбор DingDong
				BreakdownBody: Доставка ×{0} • стихия ×{1} • схема ×{2} • происхождение ×{3} • сегмент ×{4} • фаза ×{5}
				ClampTitle: Ограничение
				ClampBody: Сырой результат: ×{0}. Применено: ×{1}. Ограничение сработало: {2}.
				AgeTitle: Возраст квитанции
				AgeBody: Записано {0} игровых тиков назад. Это локальные данные интерфейса; сервер всё равно независимо проверяет боевой множитель.
			}

			EnemyKnowledge: {
				Title: Знания о врагах
				Subtitle: Особенности открываются знамёнами и остаются там, где игрок уже привык изучать существ — в Бестиарии.
				UnlockTitle: Как открыть
				UnlockBody: Получите знамя этого врага. Достаточно, чтобы предмет оказался в инвентаре: текущий персонаж выучит данные без скрытого действия в меню.
				ReadTitle: Что показывает Бестиарий
				ReadBody: Архетип, уязвимости, сопротивления и их точные множители. Отсутствующий тег означает нейтральные ×1,00, а не неизвестное поведение.
				ThresholdTitle: Что попадает в список
				ThresholdBody: Уязвимость — множитель от ×1,075. Сопротивление — до ×0,925. Меньшие отклонения остаются нейтральными, чтобы система была читаемой.
				CharacterTitle: Сетевая игра и сохранения
				CharacterBody: Знания знамён сохраняются отдельно у персонажа. Оба игрока изучают их независимо, а реальный результат урона остаётся авторитетным на сервере.
			}

			Delivery: {
				Title: Способы доставки
				Subtitle: Способ доставки отвечает на вопрос, как урон достигает цели, и может совпасть с её уязвимостью или сопротивлением.
				MeleeTitle: Прямые и метательные
				MeleeBody: "{0}: прямой контакт оружия или тела. {1}: метательное оружие. {2}: разбойничьи атаки, предоставленные модами контента."
				RangedTitle: Снаряды
				RangedBody: "{0} и {1} следуют семейству боеприпаса. {2} — обычные магические снаряды; {3} — непрерывные лучи; {4} — взрывная область."
				SummonTitle: Призывы
				SummonBody: "{0}: миньон касается цели сам. {1}: снаряд миньона. {2}: атаки стационарных призывов."
				WorldTitle: Мир и продолжающийся урон
				WorldBody: "{0}: ловушки. {1}: дебаффы и отрицательная регенерация. {2}: опасности, принадлежащие миру."
				RuleTitle: Смешанные атаки
				RuleBody: Предмет и созданный им снаряд могут показывать несколько понятных способов доставки. Реальное попадание снаряда оценивается по унаследованной линии именно этого снаряда.
			}

			Elements: {
				Title: Стихии
				Subtitle: Стихия — ключ соответствия, а не обещание статусного эффекта.
				NaturalTitle: Стихии физического мира
				NaturalBody: "{0}. Они выводятся из стабильных идентификаторов контента и явных метаданных DingDong."
				MysticTitle: Мистические и модовые стихии
				MysticBody: "{0}. «Стихия мода» — безопасная метка адаптера, если мод контента использует стихию вне родного списка DingDong."
				RuleTitle: Что делает стихия
				RuleBody: Она ищет множитель этого тега у врага. Например, мороз ×1,10 у слизня даёт 10% бонуса особенности до итогового ограничения DingDong.
				NoDebuffTitle: Чего стихия не делает
				NoDebuffBody: Огонь сам по себе не поджигает, мороз не замораживает, а молния не создаёт цепь. Такие эффекты должны исходить от оружия или другого мода и здесь тайно не создаются.
			}

			Patterns: {
				Title: Схемы и эффекты
				Subtitle: Теги схемы объясняют поведение, не притворяясь, будто каждое описание уже является активным множителем.
				BasicTitle: Временные схемы
				BasicBody: "{0}. Они различают один удар, анимацию залпа, удерживаемый урон и реальную способность повторно попадать."
				ShapeTitle: Геометрия атаки
				ShapeBody: "{0}. Они описывают прохождение сквозь цели, область, цепь и задержку, если снаряд действительно имеет такие признаки."
				CurrentTitle: Текущее правило баланса
				CurrentBody: Ни один загруженный враг сейчас не имеет ненейтрального множителя схемы или комбо быстрых ударов. Теги показаны ради прозрачности и будущих явных профилей, а не как скрытый источник силы.
				IFramesTitle: Кадры неуязвимости
				IFramesBody: DingDong не снимает кадры неуязвимости Terraria или модов. Если оружие их обходит или меняет, это делает собственная реализация оружия, а не система особенностей.
			}

			Difficulty: {
				Title: Стек сложности
				Subtitle: Показывает сложность мира Terraria и поддерживаемые режимы модов, не применяя их дважды.
				WorldTitle: Мир Terraria
				WorldBody:
					'''
					Режим: {0}
					Контекст сида: {1}
					'''
				DingDongTitle: Слой особенностей DingDong
				DingDongBody: Состояние: {0}. Его собственный итог остаётся в пределах ×0,80–×1,30 на Классике, Легендарной и поддерживаемых сложностях модов.
				ModsTitle: Моды сложности
				NoModsBody: Поддерживаемые внешние адаптеры сложности не загружены. Режим мира Terraria всё равно показан выше.
				ModBody:
					'''
					Режим: {0}
					{1}
					'''
				StackTitle: Без двойного масштабирования
				StackBody: Terraria, Calamity, Fargo и другие моды сами владеют своими хуками урона, защиты и ИИ. DingDong читает режим только для этой страницы, затем ровно один раз применяет отдельно объяснённый результат особенности.
				LegendaryTitle: Легендарная и сочетания модов
				LegendaryBody: Легендарная сложность — это режим мастера с сидом «For the Worthy». Если также включены режимы «Месть»/«Смерть» Calamity или «Вечность»/«Мазохист» Fargo, каждый слой показан здесь отдельно, а не сведён к одному вводящему в заблуждение числу.
			}
		}
	}

