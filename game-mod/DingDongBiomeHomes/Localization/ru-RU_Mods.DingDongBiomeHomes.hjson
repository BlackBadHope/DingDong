Configs: {
	DingDongServerConfig: {
		DisplayName: Серверная генерация мира

		EnableContinentalWorlds: {
			Label: Континентальный мир ×10
			Tooltip: Каждый новый мир размера «Большой» получает площадь ровно в 10 раз больше, расширенные Сахару, Арктику и Амазонию, гигантские деревья и масштабированный данж. Требует 64-битный tModLoader, значительный объём памяти и перезагрузку.
		}

		GenerateAuthoredSettlements: {
			Label: Создавать авторские биомные поселения
			Tooltip: Применяется к новым мирам и требует перезагрузки.
		}

		HousesPerDistrict: {
			Label: Домов в одном районе
			Tooltip: Сохраняет районы компактными. Проверенное значение — 3.
		}

		GenerateRoads: {
			Label: Создавать районные дороги
			Tooltip: Соединяет дома внутри каждого авторского района.
		}

		GenerateCivicHubs: {
			Label: Создавать биомные городские центры
			Tooltip: Добавляет по одному защищённому комплексу с рынком, таверной, мастерской и местом под пилон в каждый населённый биом.
		}

		EnableDamageSystem: {
			Label: Включить систему урона
			Tooltip: Включает детерминированные правила доставки, стихий, поведения, происхождения, сегментов, фаз и периодического урона.
		}

		StrictMultiplayerDamageValidation: {
			Label: Строгая серверная проверка урона
			Tooltip: Сервер отклоняет удар игрока без совпадающего проверенного намерения DingDong и повторно синхронизирует состояние цели.
		}

		EnableNpcQuestsAndEscort: {
			Label: Квесты и сопровождение жителей
			Tooltip: Включает персональное доверие, флаги домов, серверное сопровождение и выход из застреваний без скрытой телепортации.
		}

		RequiredResidentQuests: {
			Label: Квестов до переселения жителя
			Tooltip: Порог доверия от 1 до 20. После него бесконечная персональная ротация по всему загруженному контенту не прекращается.
		}

		EnableFiveTileBaseJump: {
			Label: Половинная высота базового прыжка
			Tooltip: Заменяет только базовую часть прыжка Terraria на измеренные 50% высоты; бонусы аксессуаров и модов продолжают складываться.
		}

		EnableNightPressure: {
			Label: Ночной натиск
			Tooltip: Ночью давление спавна на поверхности ×3, под землёй ×1,5, а контактный урон и урон снарядов враждебных NPC ×1,5.
		}

		EnableCreatureTeleporters: {
			Label: Телепортация NPC и существ
			Tooltip: Расширяет соединённые проводом ванильные телепорты на подходящих существ, кроме боссов.
		}

		MaximumTeleportedCreatureWidthTiles: {
			Label: Максимальная ширина существа в блоках
			Tooltip: Более широкие существа не телепортируются. По умолчанию: 6 блоков.
		}

		MaximumTeleportedCreatureHeightTiles: {
			Label: Максимальная высота существа в блоках
			Tooltip: Более высокие существа не телепортируются. По умолчанию: 6 блоков.
		}
	}

	RandomTileBudgetConfig: {
		// DisplayName: Random Tile Budget Config

		AutoNormalizeExpandedWorldGrowth: {
			// Label: Auto Normalize Expanded World Growth
			// Tooltip: ""
		}
	}
}

