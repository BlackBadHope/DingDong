	Labels: {
		Acquisition: Получение: {0}
		Synergy: Синергия реликвий: {0}
	}

	Pieces: {
		Head: +{0}% к урону и +{1}% к шансу критического удара
		Body: +{0}% к снижению урона и +{1} к регенерации здоровья
		Legs: +{0}% к скорости движения
	}

	Sets: {
		ThresholdForager: {
			Name: Собиратель порога

			Pieces: {
				Head: Капюшон
				Body: Куртка
				Legs: Следоступы
			}

			Bonus: Движение накапливает до 120 зарядов порога; следующий удар тратит их и сажает лечебное терновое эхо.
			Synergy: Природные реликвии ускоряют заряд порога на 50% и усиливают регенерацию комплекта.
			Acquisition: Создаётся из древесины, геля и упавших звёзд у верстака.
		}

		PrismGlasswright: {
			Name: Призматический стекольщик

			Pieces: {
				Head: Визор
				Body: Кираса
				Legs: Сандалии
			}

			Bonus: Критические удары высекают грани призмы; третья грань выпускает тройной преломлённый удар.
			Synergy: Сияющие реликвии усиливают направленность комплекта на критические удары.
			Acquisition: Создаётся из кактуса, стекла и линз у печи.
		}

		BurrowBell: {
			Name: Погребённый колокол

			Pieces: {
				Head: Шлем
				Body: Упряжь
				Legs: Поножи
			}

			Bonus: Неподвижность заводит погребённый колокол; следующий удар тратит заряд на защитную наземную волну.
			Synergy: Приливная реликвия позволяет колоколу заряжаться во время движения в воде.
			Acquisition: Создаётся из окаменелостей пустыни, жвал муравьиного льва и янтаря у наковальни.
		}

		HiveCantor: {
			Name: Кантор улья

			Pieces: {
				Head: Маска
				Body: Хор
				Legs: Обмотки
			}

			Bonus: Четыре последовательных удара по одной цели завершают припев и выпускают самонаводящийся рой.
			Synergy: Ядовитая или природная реликвия удваивает бонус комплекта к урону призыва.
			Acquisition: Создаётся после Королевы пчёл из воска, спор джунглей, жал и её диковины.
		}

		DungeonCartographer: {
			Name: Картограф темницы

			Pieces: {
				Head: Визир
				Body: Плащ-карта
				Legs: Путевики
			}

			Bonus: Чередование классов урона рисует маршрут; завершённый маршрут складывает карту в пробивающий удар.
			Synergy: Реликвии трёх разных источников открывают короткий путь и повышают скорость атак.
			Acquisition: Создаётся после Скелетрона из костей, паутины, золотого ключа и его следа.
		}

		CinderBellfounder: {
			Name: Литейщик угольного колокола

			Pieces: {
				Head: Клобук
				Body: Литейня
				Legs: Сабатоны
			}

			Bonus: Полученный урон звонит в печной колокол, который отвечает ударом, пропорциональным ране.
			Synergy: Пепельные реликвии повышают урон и сокращают паузу между ответными ударами.
			Acquisition: Создаётся в Преисподней из адского камня, обсидиана, огнецвета и диковины Стены плоти.
		}

		StormConductor: {
			Name: Грозовой проводник

			Pieces: {
				Head: Катушка
				Body: Куртка
				Legs: Заземлители
			}

			Bonus: Движение накапливает статический заряд; полный проводник превращает следующий удар в цепную молнию.
			Synergy: Грозовая реликвия позволяет вертикальному движению заряжать проводник так же эффективно, как бег.
			Acquisition: Создаётся в начале сложного режима из кобальта, душ полёта и проводов.
		}

		MimicBroker: {
			Name: Брокер мимиков

			Pieces: {
				Head: Монокль
				Body: Плащ-гроссбух
				Legs: Быстроходы
			}

			Bonus: Обычные удары начисляют проценты; критический удар обналичивает их в урон, здоровье и ману.
			Synergy: Две реликвии-диковины повышают удачу брокера и его кредитный предел.
			Acquisition: Создаётся после механических боссов из святых слитков, душ света и ночи и печати мимика.
		}

		FrostRelay: {
			Name: Морозное реле

			Pieces: {
				Head: Приёмник
				Body: Реле
				Legs: Бегуны
			}

			Bonus: Последовательные удары назначают отложенный повтор предыдущего попадания по той же цели.
			Synergy: Морозные реликвии продлевают память реле и усиливают повтор.
			Acquisition: Создаётся из адамантита, морозных ядер и душ полёта у мифриловой наковальни.
		}

		RootclockGardener: {
			Name: Садовник корнечасов

			Pieces: {
				Head: Цветение
				Body: Теплица
				Legs: Корнеходы
			}

			Bonus: Урон, посаженный в противника, растёт три секунды, затем расцветает накопленным уроном и лечением.
			Synergy: Природная или приливная реликвия удваивает регенерацию, пока созревает урожай.
			Acquisition: Создаётся после Плантеры из хлорофита, плода жизни, спор джунглей и её реликвии.
		}

		TempleParadox: {
			Name: Парадокс храма

			Pieces: {
				Head: Циферблат
				Body: Эпоха
				Legs: Шаги
			}

			Bonus: Часть каждой раны становится долгом времени; переживите отсрочку, чтобы вернуть её и нанести ответный удар.
			Synergy: Сияющая и теневая реликвии вместе удваивают снижение урона комплекта.
			Acquisition: Создаётся после Голема из панцирей жука, хлорофита, энергоячеек и его реликвии.
		}

		EventHorizonMason: {
			Name: Каменщик горизонта событий

			Pieces: {
				Head: Линза
				Body: Мантия
				Legs: Гравиботы
			}

			Bonus: Удары добавляют цели массу; критическая масса притягивает врагов и схлопывается во взрыв по области.
			Synergy: Теневая реликвия повышает бонус урона комплекта с 10% до 16%.
			Acquisition: Создаётся после Плантеры из эктоплазмы, грибных слитков и душ страха.
		}

		LunarCartel: {
			Name: Лунный картель

			Pieces: {
				Head: Печать
				Body: Консорциум
				Legs: Комиссии
			}

			Bonus: Попадите оружием ближнего, дальнего, магического и призывающего урона: комиссия на 10 секунд даёт +15% урона и четыре эха по 28%.
			Synergy: Реликвии из четырёх разных модов продлевают комиссию с 10 до 15 секунд.
			Acquisition: Создаётся из всех четырёх небесных фрагментов и реликвии Лунатика-сектанта.
		}

		MoonlordThreshold: {
			Name: Порог Лунного лорда

			Pieces: {
				Head: Корона
				Body: Граница
				Legs: Переход
			}

			Bonus: При активном Эхе реликвий каждый третий удар создаёт два отложенных эха по 22%; Оберег порога раз в секунду отражает 80% одной раны.
			Synergy: Полное Слияние даёт +18% урона, создаёт три эха по 32% и повышает отражение до 120%.
			Acquisition: Создаётся после Лунного лорда из люминита, всех четырёх фрагментов и его реликвии.
		}

		LegendaryBellArchitect: {
			Name: Легендарный зодчий колокола

			Pieces: {
				Head: Звонница
				Body: Собор
				Legs: Паломничество
			}

			Bonus: Каждые пять секунд комплект переключает Натиск, Убежище и Путь, меняя боевую роль вместо сложения всех бонусов.
			Synergy: Три источника реликвий и Полное Слияние включают все фазы; удар колокола срабатывает каждый третий удар с силой 125%.
			Acquisition: Вершинный рецепт легендарного мира: тяжёлый люминит, все фрагменты и Миф Лунного лорда для каждой части.
		}
	}

