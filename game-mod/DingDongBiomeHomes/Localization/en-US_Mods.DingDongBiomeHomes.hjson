Hub: {
	Title: DingDong Hub
	Tagline: Residents · quests · field guide
	Close: Close
	ScrollHint: Mouse wheel to scroll
	Reward: Reward
	Subtitle: Quests • combat • custom homes • help
	Footer: J — toggle the hub • mouse wheel — scroll • hover over an icon to see its name

	Tabs: {
		Quests: Quests
		Combat: Combat
		Residences: Residents' homes
		Help: Help
	}

	Quests.SummaryTitle: Journal overview
	Combat.Title: Combat: {0}

	Residences: {
		Title: Custom resident homes
		Subtitle: Only homes discovered by this character appear here. Unexplored locations and their residents stay hidden.
		SummaryTitle: World overview
		Summary: Discovered: {0}/{1} • built: {2} • habitable: {3} • rooms: {4}
		EmptyTitle: No homes discovered yet
		EmptyBody: Explore the world. Approaching a custom home reveals a notification and its resident's map marker.
		EntryBody:
			'''
			Biome: {0} • home #{1}
			Building center: {2}, {3} tiles
			'''
	}

	Biomes: {
		Forest: Forest
		Snow: Snow
		Desert: Desert
		Jungle: Jungle
		Ocean: Ocean
		Underground: Underground
		Hallow: The Hallow
		Mushroom: Mushroom biome
		Underworld: The Underworld
	}

	Help: {
		Title: Modpack guide
		Subtitle: DingDong's core systems and the modpack's default controls in one place.
		ControlsTitle: Basic controls
		ControlsBody:
			'''
			J — DingDong Hub and quest journal
			Mouse1 — attack; Ore Excavator with a suitable tool
			N — quick mana (moved from J to avoid a conflict)
			F6 — LuiAFK effects; F7 — LuiAFK effect settings
			'''
		ModulesTitle: Inside the hub
		ModulesBody: The journal lists active resident quests with target and reward icons. The combat guide covers weapon types, the last hit, resistances and difficulty. The homes tab keeps your character's discovered residences.
		ServerTitle: Server authority
		ServerBody: The server validates quest progress, rewards, trust, combat and relocation. This menu displays synchronized data; it cannot complete objectives on its own.
	}
}

Teleporter.CreatureTooltip: A wired pair teleports ordinary NPCs and critters; bosses, segmented creatures and oversized creatures cannot pass through.

Damage: {
	WeaponAffinity: DingDong type: {0} • element: {1}
	WeaponBehavior: Attack pattern: {0} (a description, not a hidden effect)
	WeaponGuide: "[{0}] DingDong hub • enemy trait effects are limited to ×0.80–×1.30"
	WeaponDisabled: DingDong damage is disabled by the server • [{0}] opens the hub
	BestiaryLocked: Traits are locked. Obtain ‘{0}’; this character will retain the knowledge. [{1}] opens the hub.
	BestiaryKnowledge:
		'''
		Archetype: {0}
		Weaknesses: {1}
		Resistances: {2}
		[{3}] opens the combat tab in the DingDong hub.
		'''
	WeaknessHit: Weakness: {0} ×{1}
	ResistanceHit: Resistance: {0} ×{1}
	None: none

	Guide: {
		CommandDescription: Open the DingDong damage guide.

		Common: {
			Enabled: enabled
			Disabled: disabled
			Unbound: unbound
			Weakness: weakness
			Resistance: resistance
			Neutral: neutral
			Yes: yes
			No: no
			None: none
		}

		Navigation: {
			Previous: < Back
			Next: Next >
			Page: "{0} / {1}"
		}

		Axes: {
			Delivery: delivery method
			Element: element
			Behavior: attack pattern
			Acquisition: origin
			Segment: body part
			Phase: combat phase
		}

		Coverage: {
			Explicit: explicit profile
			Inherited: inherited from the parent attack
			Adapter: automatically classified mod content
			Fallback: automatically classified Terraria content
			Unknown: unknown
		}

		Archetypes: {
			Slime: gelatinous
			Organic: organic
			Armored: armored
			Undead: undead
			Plant: plant
			Aquatic: aquatic
			Spectral: spectral
			Mechanical: mechanical
			Unknown: special
		}

		Difficulty: {
			Classic: Classic
			Expert: Expert
			Master: Master
			Legendary: Legendary (Master + For the worthy)
			Journey: Journey
			ForTheWorthy: For the worthy seed is active
			StandardSeed: For the worthy seed is not active
			NoCustomMode: no custom difficulty is active
			NoExtraToggles: no additional modes
			CompatibilityUnavailable: mode status is unavailable
			WorldNotLoaded: adapter loaded
			WorldNotLoadedDetail: World-dependent status will be read after the world finishes loading.
			CalamityDetail: Active flags: {0}. Reported difficulty scale: ×{1}; display only.
			CalamityDetailNoScale: Active flags: {0}.
			FargoDetail: Eternity vanilla behavior layer: {0}.
			Enabled: enabled
			Disabled: disabled
		}

		Pages: {
			Overview: {
				Title: Damage guide
				Subtitle: Weapon types, enemy traits, hit feedback and difficulty in one place.
				StatusTitle: Current status
				StatusBody: Server-authoritative DingDong damage layer: {0}. The server applies the same rules to every player.
				FormulaTitle: What affects a hit
				FormulaBody: Terraria and difficulty mods calculate base damage and defense. DingDong applies matching enemy traits and limits its multiplier to ×0.80–×1.30.
				ActiveTitle: Axes currently affecting damage
				ActiveBody: The loaded enemy profiles currently contain non-neutral rules for: {0}. Other displayed axes remain descriptive unless an enemy profile explicitly assigns them a rule.
				FeedbackTitle: Reading combat feedback
				FeedbackBody: Orange ‘Weakness’ means at least ×1.075. Blue ‘Resistance’ means at most ×0.925. Hits between these thresholds are neutral and do not add combat text.
				NoHiddenTitle: No hidden combo or invincibility-frame removal
				NoHiddenBody: Fast attacks do not secretly increase damage, remove invincibility frames or trigger an undocumented combo. The guide and last-hit page show every DingDong multiplier that actually contributed.
				RulesTitle: The main rule
				RulesBody: Active axes: {0}. Neutral hits do not clutter the screen. DingDong does not remove invincibility frames, create hidden combos or change NPC health outside the server's damage calculation.
			}

			CurrentWeapon: {
				Title: Current weapon
				Subtitle: Your held weapon is analyzed by the same classifier used in combat.
				EmptyTitle: No damaging weapon selected
				EmptyBody: Close the guide, hold a weapon and reopen it. Item tooltips always show delivery method, element and attack pattern.
				ReadTitle: Quick reading order
				ReadBody: Delivery method and element can match an enemy profile. Attack pattern and origin remain visible so future profile rules will not introduce hidden behavior.
				IdentityBody:
					'''
					Delivery: {0}
					Element: {1}
					'''
				PatternTitle: Attack pattern
				PatternBody: "{0}. This describes the attack's behavior; it does not grant a bonus or debuff by itself."
				OriginTitle: Origin
				OriginBody: "{0}. Origin is metadata and only affects damage when an enemy profile explicitly defines a matching rule."
				CoverageTitle: Classification source
				CoverageBody: "{0}. Modded weapons are recognized without a hard dependency on their content mod's assembly."
				ExpectTitle: Expected range
				ExpectBody: See the Bestiary for studied enemies. DingDong's contribution to a hit is always between ×0.80 and ×1.30.
			}

			LastHit: {
				Title: Last hit breakdown
				Subtitle: A local record of the last item or projectile hit evaluated by DingDong.
				EmptyTitle: No hits recorded yet
				EmptyBody: Hit a hostile creature with an item or projectile, then reopen this page. Neutral hits are recorded even when no combat text appears.
				FeedbackTitle: What this page explains
				FeedbackBody: It distinguishes a missing effect from a genuinely neutral ×1.00 result and shows which factor changed the hit.
				ResultBody:
					'''
					Result: {0}
					Final DingDong multiplier: ×{1}
					Strongest matching tag: {2}
					'''
				BreakdownTitle: Exact DingDong breakdown
				BreakdownBody: Delivery ×{0} • element ×{1} • pattern ×{2} • origin ×{3} • segment ×{4} • phase ×{5}
				ClampTitle: Limits
				ClampBody: Raw result: ×{0}. Applied: ×{1}. Limited: {2}.
				AgeTitle: Record age
				AgeBody: Recorded {0} game ticks ago. This is local UI data; the server independently verifies the combat multiplier.
			}

			EnemyKnowledge: {
				Title: Enemy knowledge
				Subtitle: Traits are unlocked by banners and displayed in the Bestiary, alongside the rest of your creature knowledge.
				UnlockTitle: How to unlock
				UnlockBody: Obtain this enemy's banner. Having the item in your inventory teaches the current character its traits without an extra menu action.
				ReadTitle: What the Bestiary shows
				ReadBody: Archetype, weaknesses, resistances and their exact multipliers. An absent tag means a neutral ×1.00, rather than unknown behavior.
				ThresholdTitle: Which traits are listed
				ThresholdBody: Weaknesses start at ×1.075; resistances are ×0.925 or below. Smaller differences remain neutral to keep the system readable.
				CharacterTitle: Multiplayer and saves
				CharacterBody: Banner knowledge is saved per character. Both players learn it independently, while the server remains authoritative over actual damage.
			}

			Delivery: {
				Title: Delivery types
				Subtitle: Delivery describes how damage reaches its target and may match the target's weakness or resistance.
				MeleeTitle: Contact and throwing
				MeleeBody: "{0}: direct weapon or body contact. {1}: thrown weapons. {2}: rogue attacks supplied by content mods."
				RangedTitle: Projectiles
				RangedBody: "{0} and {1} follow their ammunition family. {2} covers ordinary magic projectiles; {3}, continuous beams; {4}, explosions."
				SummonTitle: Summons
				SummonBody: "{0}: the minion touches the target directly. {1}: a minion's projectile. {2}: attacks by stationary summons."
				WorldTitle: World hazards and damage over time
				WorldBody: "{0}: traps. {1}: debuffs and negative life regeneration. {2}: hazards belonging to the world."
				RuleTitle: Mixed attacks
				RuleBody: An item and its projectile may display several delivery types. An actual projectile hit is evaluated using that projectile's inherited lineage.
			}

			Elements: {
				Title: Elements
				Subtitle: An element is a matching tag, not a promise of a status effect.
				NaturalTitle: Physical elements
				NaturalBody: "{0}. These come from stable content identifiers and explicit DingDong metadata."
				MysticTitle: Mystic and modded elements
				MysticBody: "{0}. Mod element is an adapter label for content mods whose elements fall outside DingDong's own list."
				RuleTitle: What an element does
				RuleBody: It looks up the enemy's multiplier for that tag. For example, frost ×1.10 on a slime gives a 10% trait bonus before DingDong's final limits.
				NoDebuffTitle: Elements and status effects
				NoDebuffBody: Every element except neutral and mod element leaves a short capped status on hit: fire burns, frost frostburns and briefly chills (never bosses), poison poisons, shadow ignites shadowflame, water soaks, gel oils, nature calls Dryad's Bane, lightning shocks (three times harder on wet targets), earth cracks armor (hits ignore 8 defense), holy radiates (4 hp/s, 8% weaker contact hits), astral marks (+6% damage taken) and void drains life. Composite weapons forged from other weapons also apply the elements of their source weapons, listed in their tooltip.
			}

			Patterns: {
				Title: Patterns and effects
				Subtitle: Pattern tags describe behavior. A description only becomes a damage modifier when a profile explicitly defines one.
				BasicTitle: Timing patterns
				BasicBody: "{0}. These distinguish single hits, burst animations, sustained damage and the ability to hit repeatedly."
				ShapeTitle: Attack geometry
				ShapeBody: "{0}. These describe piercing, areas, chains and delays when the projectile actually has those properties."
				CurrentTitle: Current balance rule
				CurrentBody: No loaded enemy currently has a non-neutral pattern or rapid-hit combo multiplier. Tags are shown for clarity and future explicit profiles; they grant no hidden power.
				IFramesTitle: Invincibility frames
				IFramesBody: DingDong does not remove Terraria's or other mods' invincibility frames. Weapons that bypass or change them do so through their own implementation.
			}

			Difficulty: {
				Title: Difficulty stack
				Subtitle: Shows the Terraria world difficulty and supported mod modes without applying them twice.
				WorldTitle: Terraria world
				WorldBody:
					'''
					Mode: {0}
					Seed context: {1}
					'''
				DingDongTitle: DingDong trait layer
				DingDongBody: State: {0}. Its own final result stays between ×0.80 and ×1.30 in Classic, Legendary and supported mod difficulties.
				ModsTitle: Difficulty mods
				NoModsBody: No supported external difficulty adapters are loaded. The Terraria world mode is still shown above.
				ModBody:
					'''
					Mode: {0}
					{1}
					'''
				StackTitle: No duplicate scaling
				StackBody: Terraria, Calamity, Fargo and other mods own their damage, defense and AI hooks. DingDong reads the mode for this page, then applies its separately explained trait result exactly once.
				LegendaryTitle: Legendary and mod combinations
				LegendaryBody: Legendary means Master mode with the For the Worthy seed. When Calamity's Revengeance/Death or Fargo's Eternity/Masochist is also active, each layer remains visible here instead of being collapsed into one misleading number.
			}
		}
	}

