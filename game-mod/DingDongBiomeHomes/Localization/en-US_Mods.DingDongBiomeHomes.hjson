Configs: {
	DingDongServerConfig: {
		DisplayName: Server world generation

		EnableContinentalWorlds: {
			Label: Continental world presets
			Tooltip: World presets by RAM (12 / 16 / 24 / 32 GB) replace Small, Medium and Large and are always on. Emergency only: setting "RestoreVanillaWorldSizes": true in this config file while the game is closed restores the vanilla sizes without Ding Dong continental features.
		}

		GenerateAuthoredSettlements: {
			Label: Generate custom biome settlements
			Tooltip: Applies to new worlds and requires a reload.
		}

		HousesPerDistrict: {
			Label: Houses per district
			Tooltip: Keeps districts compact. The verified value is 3.
		}

		GenerateRoads: {
			Label: Generate district roads
			Tooltip: Connects houses within each custom district.
		}

		GenerateCivicHubs: {
			Label: Generate biome civic centers
			Tooltip: Adds one protected complex with a market, tavern, workshop and pylon site to each inhabited biome.
		}

		EnableDamageSystem: {
			Label: Enable damage system
			Tooltip: Enables deterministic rules for delivery, elements, attack behavior, origins, segments, phases and damage over time.
		}

		StrictMultiplayerDamageValidation: {
			Label: Strict server damage validation
			Tooltip: The server rejects player hits without a matching verified DingDong intent and resynchronizes the target's state.
		}

		EnableNpcQuestsAndEscort: {
			Label: Resident quests and escorting
			Tooltip: Enables individual trust, residence flags, server-controlled escorting and recovery from stuck paths without hidden teleportation.
		}

		RequiredResidentQuests: {
			Label: Quests required for relocation
			Tooltip: Trust threshold from 1 to 20. Reaching it does not end the resident's unlimited personal quest rotation across loaded content.
		}

		EnableFiveTileBaseJump: {
			Label: Half-height base jump
			Tooltip: Replaces only Terraria's base jump contribution with a measured 50% apex; accessory and mod bonuses remain additive.
		}

		EnableNightPressure: {
			Label: Night pressure
			Tooltip: At night, surface spawn pressure is 3x, underground pressure is 1.5x, and hostile NPC contact/projectile damage is 1.5x.
		}

		EnableCreatureTeleporters: {
			Label: Teleport NPCs and creatures
			Tooltip: Allows wired vanilla teleporters to transport eligible creatures, excluding bosses.
		}

		MaximumTeleportedCreatureWidthTiles: {
			Label: Maximum creature width in tiles
			Tooltip: Wider creatures cannot teleport. Default: 6 tiles.
		}

		MaximumTeleportedCreatureHeightTiles: {
			Label: Maximum creature height in tiles
			Tooltip: Taller creatures cannot teleport. Default: 6 tiles.
		}
	}

	RandomTileBudgetConfig: {
		DisplayName: Random Tile Budget Config

		AutoNormalizeExpandedWorldGrowth: {
			Label: Auto Normalize Expanded World Growth
			Tooltip: ""
		}
	}
}

