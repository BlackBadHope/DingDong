MobRelics: {
	ClassicCondition: Classic world only
	ExactExpertCondition: Expert world only (not Master)
	ExactMasterCondition: Master world only (not Legendary)
	LegendaryCondition: Legendary world (Master Mode and For the Worthy)

	Mechanics: {
		UniqueDrop: "{0}. Unique drop of {1} from {2}."

		Availability: {
			CommonTrace: Ordinary random drop
			CommonCurio: Ordinary random drop
			ExpertSeal: Expert world pool only
			MasterRelic: Master world pool only
			LegendaryMyth: Legendary world only
		}

		Effect: {
			CommonTrace: Equippable hunter relic: +{0} all damage and +{1}% critical strike chance.
			CommonCurio: Equippable pathfinder relic: +{0} movement speed, +{1} attack speed, and -{2} mana cost.
			ExpertSeal: Equippable guardian relic: +{0} defense, +{1} damage reduction, and +{2} life regeneration.
			MasterRelic: Equippable echo relic: +{0} all damage; resonance has {1} base chance to launch a {2} echo for {3} of the triggering hit.
			LegendaryMyth: Equippable myth: +{0} all damage, +{1} movement speed, +{2} maximum life, and +{3} maximum mana; empowers echo and ward reactions.
		}

		Synergy: Synergy: equip 2/3/4/all 5 relics of {0} for Link, Echo, Ward, and Convergence. Equip relics from 3+ different {1} enemies for Provider Harmony.

		Aspect: {
			Cinder: cinder
			Frost: frost
			Storm: storm
			Venom: venom
			Radiant: radiant
			Umbral: umbral
			Tidal: tidal
			Verdant: verdant
		}
	}

