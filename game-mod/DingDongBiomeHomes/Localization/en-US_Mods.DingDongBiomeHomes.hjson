SynergyArmor: {
	Labels: {
		Acquisition: Acquisition: {0}
		Synergy: Relic synergy: {0}
	}

	Pieces: {
		Head: +{0}% damage and +{1}% critical strike chance
		Body: +{0}% damage reduction and +{1} life regeneration
		Legs: +{0}% movement speed
	}

	Sets: {
		ThresholdForager: {
			Name: Threshold Forager

			Pieces: {
				Head: Cap
				Body: Coat
				Legs: Treads
			}

			Bonus: Movement stores up to 120 threshold charge; the next hit spends it to plant a healing briar echo.
			Synergy: Verdant relics charge the threshold 50% faster and raise the set's life regeneration.
			Acquisition: Crafted from wood, gel and fallen stars at a work bench.
		}

		PrismGlasswright: {
			Name: Prism Glasswright

			Pieces: {
				Head: Visor
				Body: Cuirass
				Legs: Sandals
			}

			Bonus: Critical hits cut prism facets; the third facet releases a three-way refracted strike.
			Synergy: Radiant relics strengthen the set's critical-strike focus.
			Acquisition: Crafted from cactus, glass and lenses at a furnace.
		}

		BurrowBell: {
			Name: Buried Bell

			Pieces: {
				Head: Helm
				Body: Harness
				Legs: Greaves
			}

			Bonus: Stand still to wind the buried bell; your next hit spends the charge on a defensive ground pulse.
			Synergy: A Tidal relic lets the bell keep winding while you move through water.
			Acquisition: Crafted from desert fossils, antlion mandibles and amber at an anvil.
		}

		HiveCantor: {
			Name: Hive Cantor

			Pieces: {
				Head: Mask
				Body: Chorus
				Legs: Legwraps
			}

			Bonus: Four consecutive hits on one enemy complete a chorus and release a homing swarm.
			Synergy: Venom or Verdant relics double the set's summon-damage bonus.
			Acquisition: Crafted after Queen Bee from bee wax, jungle spores, stingers and a Crabulon Curio.
		}

		DungeonCartographer: {
			Name: Dungeon Cartographer

			Pieces: {
				Head: Surveyor
				Body: Mapcoat
				Legs: Pathfinders
			}

			Bonus: Alternating damage classes draws a route; completing it folds the map into a piercing strike.
			Synergy: Relics from three different providers reveal a shortcut and increase attack speed.
			Acquisition: Crafted after Skeletron from bones, cobwebs, a golden key and a Glowmoth Trace.
		}

		CinderBellfounder: {
			Name: Cinder Bellfounder

			Pieces: {
				Head: Cowl
				Body: Foundry
				Legs: Sabatons
			}

			Bonus: Taking damage rings a furnace bell that retaliates in proportion to the wound.
			Synergy: Cinder relics increase damage and shorten the interval between retaliations.
			Acquisition: Crafted in the Underworld from hellstone, obsidian, fireblossom and a Grand Thunder Bird Curio.
		}

		StormConductor: {
			Name: Storm Conductor

			Pieces: {
				Head: Coil
				Body: Jacket
				Legs: Grounders
			}

			Bonus: Movement stores static charge; a full conductor makes the next hit chain through nearby enemies.
			Synergy: A Storm relic makes vertical movement charge the conductor as efficiently as running.
			Acquisition: Crafted in early Hardmode from cobalt, souls of flight and wire.
		}

		MimicBroker: {
			Name: Mimic Broker

			Pieces: {
				Head: Monocle
				Body: Ledgercoat
				Legs: Quicksteps
			}

			Bonus: Normal hits accrue interest; a critical hit liquidates it into bonus damage, life and mana.
			Synergy: Two Curio relics improve the broker's luck and credit ceiling.
			Acquisition: Crafted after the mechanical bosses from hallowed bars, souls of light and night, and an Eye of Cthulhu Curio.
		}

		FrostRelay: {
			Name: Frostbound Relay

			Pieces: {
				Head: Receiver
				Body: Relay
				Legs: Runners
			}

			Bonus: Successive hits schedule a delayed replay of the previous impact on the same target.
			Synergy: Frost relics lengthen the relay's memory and strengthen its replay.
			Acquisition: Crafted from adamantite, frost cores and souls of flight at a mythril anvil.
		}

		RootclockGardener: {
			Name: Rootclock Gardener

			Pieces: {
				Head: Bloom
				Body: Greenhouse
				Legs: Rootwalkers
			}

			Bonus: Damage planted in one enemy grows for three seconds, then blooms as stored damage and healing.
			Synergy: Verdant or Tidal relics double the set's regeneration while the crop matures.
			Acquisition: Crafted after Plantera from chlorophyte, life fruit, jungle spores and a Crabulon Curio.
		}

		TempleParadox: {
			Name: Temple Paradox

			Pieces: {
				Head: Dial
				Body: Epoch
				Legs: Steps
			}

			Bonus: Part of each wound becomes time debt; survive the interval to refund it and retaliate.
			Synergy: Radiant and Umbral relics together double the set's damage reduction.
			Acquisition: Crafted after Golem from beetle husks, chlorophyte, power cells and a Glowmoth Curio.
		}

		EventHorizonMason: {
			Name: Event Horizon Mason

			Pieces: {
				Head: Lens
				Body: Mantle
				Legs: Gravboots
			}

			Bonus: Hits add mass to the target; critical mass pulls nearby enemies inward and collapses into an area strike.
			Synergy: An Umbral relic raises the set's damage bonus from 10% to 16%.
			Acquisition: Crafted after Plantera from ectoplasm, shroomite and souls of fright.
		}

		LunarCartel: {
			Name: Lunar Cartel

			Pieces: {
				Head: Seal
				Body: Consortium
				Legs: Commissions
			}

			Bonus: Land melee, ranged, magic and summon hits to earn a 10-second commission: +15% damage and four 28% echoes.
			Synergy: Relics from four different mods extend the commission from 10 to 15 seconds.
			Acquisition: Crafted from all four celestial fragments and a Grand Thunder Bird Curio.
		}

		MoonlordThreshold: {
			Name: Moon Lord Threshold

			Pieces: {
				Head: Crown
				Body: Boundary
				Legs: Crossing
			}

			Bonus: With Relic Echo active, every third hit creates two delayed 22% echoes; Threshold Ward reflects 80% of one wound per second.
			Synergy: Full Convergence grants +18% damage, creates three 32% echoes and raises reflection to 120%.
			Acquisition: Crafted after Moon Lord from luminite, all four fragments and an Eye of Cthulhu Curio.
		}

		LegendaryBellArchitect: {
			Name: Legendary Bell Architect

			Pieces: {
				Head: Belfry
				Body: Cathedral
				Legs: Pilgrimage
			}

			Bonus: Every five seconds the set cycles Offense, Shelter and Passage, changing its combat role instead of stacking all bonuses.
			Synergy: Three relic providers plus Full Convergence activate all phases; the bell strike triggers every third hit for 125% damage.
			Acquisition: Legendary-world apex craft using heavy luminite, every fragment and a Glowmoth Myth for each piece.
		}
	}

