AutoUncraft: {
	SlotHint: Auto-uncraft: place an item to add its rule. Left-click to put or take the stack; right-click to take one. The switch pauses processing.
	TrashSlotHint: Auto Trash: place an item to add its rule. Click an empty cursor to recover the last stack and remove that rule. The switch controls automatic pickup disposal.
	FavoriteHint: Favorited items are protected. Remove the favorite mark before placing this item.
	TrashEnabled: Auto Trash ON ({0} rules)
	TrashDisabled: Auto Trash OFF ({0} rules)
	TrashShowList: Show and edit Auto Trash rules
	TrashTitle: Auto Trash ({0} rules)
	TrashSafetyHint: Listed pickups only. The last discarded stack can be recovered from the slot.
	CannotUncraft: No basic dismantling recipe is available.
	Enabled: Auto-uncraft ON ({0} rules)
	Disabled: Auto-uncraft OFF ({0} rules)
	ShowList: Show and edit auto-uncraft rules
	Preview: "Dismantling {0} returns up to: {1}"
	RatioHint: The configured Lans return ratio and random rounding apply.
	Title: Auto-uncraft ({0} rules)
	EditHint: Add via the slot; click a listed item to remove it.
	SafetyHint: Only listed items; favorites are protected. Full inventory pauses processing.
	RemoveHint: Click to remove this rule.
}

Uncraft: {
	BasicOnly: Only the basic recipe for this exact item can be dismantled.
	NoBasicRecipe: This item has no basic dismantling recipe. Crafting-group item exchanges are disabled.
}

ResidenceDiscovery: {
	Discovered: NPC home discovered: {0}. This NPC is now visible on your map in this world.
	QuestTarget: Quest target for {0}: {1}
}

WorldCreation: {
	LoadMemoryDenied:
		'''
		The world could not start because Windows has insufficient memory available.

		{0}

		Close unused applications and try again. This refusal does not mean that the world is corrupt. Your world and its backups have not been changed.
		'''
	// Presets 28.10: world presets by total PC RAM (single player). They replace Small/Medium/Large.
	Presets: {
		ram8: {
			Name: "8 GB (page file required)"
			Description: Continent 14,000 x 4,200 tiles (2.9 Large-world areas). Estimated need about 10.5-12.5 GB for the whole PC in single player (estimate): an 8 GB PC needs a page file of 16 GB or more, a closed browser and patience. Host & Play needs more. Requires 64-bit tModLoader; memory is checked before creation.
		}

		ram12: {
			Name: "12 GB"
			Description: Continent 16,800 x 4,800 tiles (4.0 Large-world areas). Estimated need about 11-13 GB for the whole PC in single player (estimate); keep a Windows page file enabled and close the browser. Host & Play (server and client on one PC) needs more. Requires 64-bit tModLoader; memory is checked before creation.
		}

		ram16: {
			Name: "16 GB"
			Description: Continent 20,400 x 6,000 tiles (6.1 Large-world areas). Estimated need about 12-14 GB for the whole PC in single player (estimate); keep a Windows page file enabled. Host & Play (server and client on one PC) needs more. Requires 64-bit tModLoader; memory is checked before creation.
		}

		ram24: {
			Name: "24 GB"
			Description: Continent 23,800 x 6,600 tiles (7.8 Large-world areas). Estimated need about 13-15 GB for the whole PC in single player (estimate). Host & Play (server and client on one PC) needs more. Requires 64-bit tModLoader; memory is checked before creation.
		}

		ram32: {
			Name: "32 GB — World x10"
			Description: Continental world — 28,000 x 7,200 tiles, exactly ten Large-world areas. Requires 64-bit tModLoader and sufficient free RAM and Windows commit headroom. Memory is checked before creation. Estimated need about 14-16 GB for the whole PC in single player (estimate); Host & Play (server and client on one PC) needs a 32 GB PC.
		}
	}

	PresetRecommended: Recommended for your PC.
	PresetAboveRam: Warning: this preset is meant for {0} GB of RAM and this PC has {1} GiB. It stays available, but creation may be refused by the memory check or run slowly with the page file.
	PresetResidencesUnproven: Preview: placement of all 61 residences is not yet proven on this size.
	MemoryDenied:
		'''
		{1} was not started. Your world settings are preserved.

		{0}

		Free RAM and available Windows commit are different limits. Close unused applications or review Windows paging-file settings, then try again, or select a smaller world. Ding Dong has not changed your paging file or closed any applications.
		'''
}

Items: {
	KeyringItem: {
		DisplayName: Keyring
		Tooltip:
			'''
			Holds every key, chest key and lockpick
			Right-click with a key on the cursor to store it; right-click with an empty cursor to open the ring
			Keys you pick up go straight into the ring; a locked chest takes its key from the ring
			'''
	}
	SpiritWardTotemItem: {
		DisplayName: Spirit Ward Totem
		Tooltip:
			'''
			Place it on the floor of your home
			Wraiths, ghosts, reapers and other enemies that pass through walls
			no longer spawn around a player within one screen of the totem
			Enemies that respect walls are unaffected
			'''
	}

	ResidenceFlagItem: {
		DisplayName: NPC Home Flag
		Tooltip:
			'''
			Place it inside a complete vacant NPC house and right-click to claim the home
			After earning a resident's trust, choose “I'll lead you to a new home” in dialogue
			The resident must physically follow you there; their home point changes only on arrival
			'''
	}

	ClassicResidentCache: {
		DisplayName: Classic Resident Cache
		Tooltip: Right-click to open a useful supply bundle earned from a resident quest.
	}

	ExpertResidentCache: {
		DisplayName: Expert Resident Cache
		Tooltip: Right-click to open an improved supply bundle.
	}

	MasterResidentCache: {
		DisplayName: Master Resident Cache
		Tooltip: Right-click to open a high-tier supply bundle.
	}

	LegendaryResidentCache: {
		DisplayName: Legendary Resident Cache
		Tooltip: Right-click to open the most valuable resident supply bundle.
	}

	PorchlightBlade: {
		DisplayName: Porchlight Blade
		Tooltip: A lantern-guided oak blade made for the first night.
	}

	GildedGableGlaive: {
		DisplayName: Gilded Gable Glaive
		Tooltip: A balanced noble blade framed like a shining townhouse roof.
	}

	CinderChimneyCleaver: {
		DisplayName: Cinder Chimney Cleaver
		Tooltip: Ember vents pulse through its blackened hellstone edge.
	}

	HallowedHearthbrand: {
		DisplayName: Hallowed Hearthbrand
		Tooltip: Stained glass turns every swing into a flash of sanctuary light.
	}

	SolarHomesteadGreatblade: {
		DisplayName: Solar Homestead Greatblade
		Tooltip: A roof of solar shingles reforged into one colossal edge.
	}

	ShinglewoodShortbow: {
		DisplayName: Shinglewood Shortbow
		Tooltip: Layered cedar limbs keep this early bow steady and light.
	}

	GildedWindowRepeater: {
		DisplayName: Gilded Window Repeater
		Tooltip: A sapphire window sights each arrow along the same bright line.
	}

	CinderlockCarbine: {
		DisplayName: Cinderlock Carbine
		Tooltip: Its chimney muzzle vents heat between rapid bullet shots.
	}

	HallowedRooftopRepeater: {
		DisplayName: Hallowed Rooftop Repeater
		Tooltip: Winged eaves guide arrows through a stained-glass mechanism.
	}

	VortexEavestrike: {
		DisplayName: Vortex Eavestrike
		Tooltip: A swept alien roofline stabilizes its relentless bullet stream.
	}

	CandlewickWand: {
		DisplayName: Candlewick Wand
		Tooltip: A blue porch flame kindles a careful opening spell.
	}

	AtticStarScepter: {
		DisplayName: Attic Star Scepter
		Tooltip: An attic window focuses starlight into violet bolts.
	}

	HearthflameTome: {
		DisplayName: Hearthflame Tome
		Tooltip: Its pages open into a furnace arch of guided fire.
	}

	SanctumLanternStaff: {
		DisplayName: Sanctum Lantern Staff
		Tooltip: A hallowed lantern scatters a storm of crystalline light.
	}

	NebulaThresholdGrimoire: {
		DisplayName: Nebula Threshold Grimoire
		Tooltip: Open the cosmic doorway and let the nebula answer.
	}

	TwinebellLash: {
		DisplayName: Twinebell Lash
		Tooltip: A humble braided whip whose bell calls minions to attention.
	}

	BriarThresholdWhip: {
		DisplayName: Briar Threshold Whip
		Tooltip: Thorny living cord guards every doorway it crosses.
	}

	FurnaceChain: {
		DisplayName: Furnace Chain
		Tooltip: Each black-iron link carries a spark from the underworld forge.
	}

	PrismaticBanisterLash: {
		DisplayName: Prismatic Banister Lash
		Tooltip: Stained-glass links crack like a radiant palace railing.
	}

	StardustWelcomeCord: {
		DisplayName: Stardust Welcome Cord
		Tooltip: Silver keys and woven stardust welcome the final procession.
	}

