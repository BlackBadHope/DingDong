			WormCape: {
				DisplayName: Worm Cape
				Tooltip: Spawns worms as you walk. Truffle worms will not flee from you.
			}

			BaitDisperser: {
				DisplayName: Bait Disperser
				Tooltip: Inflicts used bait Debuffs to all surrounding enemies in a 8 block radius
			}

			BarbedHook: {
				DisplayName: Barbed Hook
				Tooltip: Increase fishing crit by 10%
			}

			CrateCallingHook: {
				DisplayName: Crate Calling Hook
				Tooltip: 5% chance for the enemy dropping a crate on kill. Crate type depends on the rod used
			}

			CurrencyHook: {
				DisplayName: Currency Hook
				Tooltip: 0.5% chance for hooked enemy to drop some money after a bob. Money types change with game progression
			}

			HeavenlyHook: {
				DisplayName: Heavenly Hook
				Tooltip: Increase fishing damage based on player altitude
			}

			RetractableHook: {
				DisplayName: Retractable Hook
				Tooltip: Allows the bobber to attack when returning to you!
			}

			RustyHook: {
				DisplayName: Rusty Hook
				Tooltip: Increase fishing damage if enemy is under water
			}

			SealedHook: {
				DisplayName: Sealed Hook
				Tooltip: Seals bobber-stuck enemies damage by 20%
			}

			SuperBarbedHook: {
				DisplayName: Super Barbed Hook
				Tooltip: Increase fishing crit by 20%
			}

			SuperiorBaitDisperser: {
				DisplayName: Superior Bait Disperser
				Tooltip: Inflicts used bait Debuffs to all surrounding enemies in a 16 block radius
			}

			UrgencyBobSpeeder: {
				DisplayName: Urgency Bob Speeder
				Tooltip: The lower the health, the faster the bob moves (up to 75% faster)
			}

			Wormicide: {
				DisplayName: Wormicide
				Tooltip: Doubles bobber damage when stuck on a worm-like enemy
			}

			BlazingFishingKnife: {
				DisplayName: Blazing Fishing Knife
				Tooltip:
					'''
					Attacks enemies who are very near you, once every second.
					           80 base Damage.
					           Average knockback.
					           Inflicts Solar Fire debuff.
					           Double damage to enemies stuck to your bobber.
					'''
			}

			FishingKnife: {
				DisplayName: Fishing Knife
				Tooltip:
					'''
					Attacks enemies who are very near you, once every second.
					           40 base Damage.
					           Average knockback.
					           Double damage to enemies stuck to your bobber.
					'''
			}

			FractaliteFishingKnife: {
				DisplayName: Fractalite Fishing Knife
				Tooltip:
					'''
					Attacks enemies who are near you, twice per second.
					           120 base Damage.
					           Strong knockback.
					           Inflicts Frost Fire debuff.
					           Double damage to enemies stuck to your bobber.
					'''
			}

			WoodenFishingKnife: {
				DisplayName: Wooden Fishing Knife
				Tooltip:
					'''
					Attacks enemies who are almost touching you, once every 2 seconds.
					           15 base Damage.
					           Weak knockback.
					           Double damage to enemies stuck to your bobber.
					'''
			}

			BobLoser: {
				DisplayName: Bob Loser
				Tooltip: Removes one fishing line from the rod using it. One line will always remain
			}

			BoxOfCountlessLures: {
				DisplayName: Box Of Countless Lures
				Tooltip: Allows for casting thirty-two extra lines while fishing
			}

			BoxOfLures: {
				DisplayName: Box Of Lures
				Tooltip: Allows for casting sixteen extra lines while fishing
			}

			DoubleBobLoser: {
				DisplayName: Double Bob Loser
				Tooltip: Removes two fishing lines from the rod using it. One line will always remain
			}

			DoubleLure: {
				DisplayName: Double Lure
				Tooltip: Allows for casting two extra lines while fishing
			}

			DoubleSelectiveBobbers: {
				DisplayName: Double Selective Bobbers
				Tooltip: Only two bobbers will hook to the same enemy
			}

			ExtraLure: {
				DisplayName: Extra Lure
				Tooltip: Allows for casting one extra lines while fishing
			}

			OctoLure: {
				DisplayName: Octo Lure
				Tooltip: Allows for casting eight extra lines while fishing
			}

			Omnilure: {
				DisplayName: Omnilure
				Tooltip: Forces only one lure, but with 20% more damage
			}

			QuadBobLoser: {
				DisplayName: Quad Bob Loser
				Tooltip: Removes four fishing line from the rod using it. One line will always remain
			}

			QuadLure: {
				DisplayName: Quad Lure
				Tooltip: Allows for casting four extra lines while fishing
			}

			SelectiveBobbers: {
				DisplayName: Selective Bobbers
				Tooltip: Only one bobber will hook to the same enemy
			}

			SmartBobbers: {
				DisplayName: Smart Bobbers
				Tooltip: Bobbers will try to distribute themselves equaly on targeted enemies, on a two block range
			}

			TurretBobbers: {
				DisplayName: Turret Bobbers
				Tooltip:
					'''
					Bobbers will not hook to any enemy
					30% extra Fishing Damage
					'''
			}

			FastMetronome: {
				DisplayName: Fast Metronome
				Tooltip: Increases bob speed by 10%, but decreases fishing damage by 8%
			}

			HyperFastMetronome: {
				DisplayName: Hyper Fast Metronome
				Tooltip: Increases bob speed by 30%, but decreases fishing damage by 26%
			}

			HyperSlowMetronome: {
				DisplayName: Hyper Slow Metronome
				Tooltip: Increases fishing damage by 30%, but decreases bob speed by 20%
			}

			SlowMetronome: {
				DisplayName: Slow Metronome
				Tooltip: Increases fishing damage by 10%, but decreases bob speed by 5%
			}

			SuperFastMetronome: {
				DisplayName: Super Fast Metronome
				Tooltip: Increases bob speed by 20%, but decreases fishing damage by 18%
			}

			SuperSlowMetronome: {
				DisplayName: Super Slow Metronome
				Tooltip: Increases fishing damage by 20%, but decreases bob speed by 15%
			}

			BobAccelerator: {
				DisplayName: Bob Accelerator
				Tooltip: Increases your casting speed by 30%
			}

			BobScope: {
				DisplayName: Bob Scope
				Tooltip: Tries to hit all your bobbers where your cursor is aiming
			}

			DiscardableBobs: {
				DisplayName: Discardable Bobs
				Tooltip: Allows you to re-cast very fast if bobs are retrieved from an enemy (right-click with rod)
			}

			FasterFishingKit: {
				DisplayName: Faster Fishing Kit
				Tooltip:
					'''
					Allows you to re-cast very fast if bobs are retrieved from an enemy (right-click with rod).
					   Tries to hit your bobber where your cursor is aiming.
					   Increases your casting speed by 30 %
					'''
			}

			FishermansKit: {
				DisplayName: Fishermans Kit
				Tooltip: Allows you to use several types of Fishing Accessories directly from your inventory!
			}

			FishermansKit1: {
				DisplayName: Fishermans Kit1
				Tooltip: Allows you to use several types of Fishing Accessories directly from your piggy bank!
			}

			FishermansKit2: {
				DisplayName: Fishermans Kit2
				Tooltip: Allows you to use several types of Fishing Accessories directly from your safe!
			}

			FishermansKit3: {
				DisplayName: Fishermans Kit3
				Tooltip: Allows you to use several types of Fishing Accessories directly from your Defender's Forge!
			}

			FishermansKit4: {
				DisplayName: Fishermans Kit4
				Tooltip: Allows you to use several types of Fishing Accessories directly from your Void Vault!
			}

			FishSlicer: {
				DisplayName: Fish Slicer
				Tooltip: Turns all caught fish into Fish Steaks (if they can be converted)
			}

			KillingGate: {
				DisplayName: Killing Gate
				Tooltip:
					'''
					Converts caught items with a Max Stack of 1 into coins.
					Turns all caught fish into Fish Steaks (if they can be converted).
					'''
			}

			MagneticTargetedThrow: {
				DisplayName: Magnetic Targeted Throw
				Tooltip:
					'''
					Sticks your bobbers to your mouse when getting too close.
					Only works if your mouse is in the trajectory of the bobber.
					They will follow the mouse until they either stick to something, get wet (with no Sinker) or you call them back.
					'''
			}

			ManaEscalationReel: {
				DisplayName: Mana Escalation Reel
				Tooltip: Increases bobber damage by 2% each second, but costs 8 mana per second
			}

			MaximumManaEscalationReel: {
				DisplayName: Maximum Mana Escalation Reel
				Tooltip: Increases bobber damage by 12% each second, but costs 24 mana per second (maximum 300%)
			}

			RetractableFasterFishingKit: {
				DisplayName: Retractable Faster Fishing Kit
				Tooltip:
					'''
					Allows you to re-cast very fast if bobs are retrieved from an enemy (right-click with rod)
					   Tries to hit your bobber where your cursor is aiming
					   Increases your casting speed by 30 %
					   Allows the bobber to attack when returning to you!
					'''
			}

			SellGate: {
				DisplayName: Sell Gate
				Tooltip: Converts caught items with a Max Stack of 1 into coins
			}

			Sinker: {
				DisplayName: Sinker
				Tooltip:
					'''
					Makes bobbers Sink into water when cast. Does not allow for Fishing.
					Also, 5% Bob speed and Fishing damage increase if the player is underwater
					'''
			}

			StickyTargetedThrow: {
				DisplayName: Sticky Targeted Throw
				Tooltip:
					'''
					Sticks your bobbers to your mouse when getting too close
					Only works if your mouse is in the trajectory of the bobber
					They fall off if you remove the mouse
					'''
			}

			StrongerManaEscalationReel: {
				DisplayName: Stronger Mana Escalation Reel
				Tooltip: Increases bobber damage by 7% each second, but costs 16 mana per second
			}

			TargetedThrow: {
				DisplayName: Targeted Throw
				Tooltip:
					'''
					Stops your bobbers when getting too close to your mouse
					Only works if your mouse is in the trajectory of the bobber
					'''
			}

			ManaShieldShaft: {
				DisplayName: Mana Shield Shaft
				Tooltip: Up to 15% of all damage received is deducted from your Mana instead
			}

			MaximumManaShieldShaft: {
				DisplayName: Maximum Mana Shield Shaft
				Tooltip: Up to 50% of all damage received is deducted from your Mana instead
			}

			ProjectileCancelerShaft: {
				DisplayName: Projectile Canceler Shaft
				Tooltip: 30% chance to disable an incoming hostile projectile if hooked to an enemy
			}

			StrongerManaShieldShaft: {
				DisplayName: Stronger Mana Shield Shaft
				Tooltip: Up to 30% of all damage received is deducted from your Mana instead
			}

			HookshotWire: {
				DisplayName: Hookshot Wire
				Tooltip: Always reeled in towards the enemy
			}

			LinkCable: {
				DisplayName: Link Cable
				Tooltip: Damage increased by ammount bobbers stuck to different enemies
			}

			MoonWire: {
				DisplayName: Moon Wire
				Tooltip: Increases fishing damage based on the weather, time and moon phase
			}

			RedirectorWire: {
				DisplayName: Redirector Wire
				Tooltip: Thorns damage is instead dealt equally to all enemies with your bobber attached
			}

			SyphoningWire: {
				DisplayName: Syphoning Wire
				Tooltip: Provides 10% mana Syphon on damage dealt with the bobber
			}

			ThornyRedirectorWire: {
				DisplayName: Thorny Redirector Wire
				Tooltip: Thorns damage is also dealt equally to all enemies with your bobber attached
			}

			TitanWire: {
				DisplayName: Titan Wire
				Tooltip: Can always reel in the enemy, no matter the size (except if immobile). Fishing line never breaks
			}

			VacuumWire: {
				DisplayName: Vacuum Wire
				Tooltip: Items in contact with the bobber will be picked up
			}

			VampiricWire: {
				DisplayName: Vampiric Wire
				Tooltip: Provides 10% life steal on damage dealt with the bobber
			}

