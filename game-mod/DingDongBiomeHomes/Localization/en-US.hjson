		Configs: {
			UnuPlayerConfig: {
				startWithRod: {
					Tooltip: ""
					Label: Start with Wooden Battlerod
				}

				startWithBait: {
					Tooltip: ""
					Label: Start with Poison Bait
				}

				DisplayName: Unu Player Config
			}

			FishSteakRecipesConfig: {
				DisplayName: Fish Steak Recipes Config

				fishRecipes: {
					Label: Fish Steak Value
					Tooltip: List of items that can be converted into Fish Steaks. Changing it requires reload.
				}

				fishRecipesNotAuto: {
					Label: Fish that the Slicer won't cut
					Tooltip: List of items that can't be converted into Fish Steaks automatically using the Fish Slicer or Killing Gate. Changing it does not require reload.
				}
			}

			FishToReplaceConfig: {
				DisplayName: Fish To Replace Config

				replaceAllFish: {
					Label: Replace all fish
					Tooltip: This mod will be able to replace any fished items with its own. If set, the below list is ignored.
				}

				fishToReplace: {
					Label: Fish to Replace
					Tooltip: List of fished items that can be replaced with this mod's items. Changing it does not require reload.
				}
			}

			UnuServerConfig: {
				DisplayName: Unu Server Config

				allowPrefixes: {
					Label: Allow rod prefixes
					Tooltip: If this mod should roll prefixes for the rods. Disable it for a less easy time.
				}

				allowBorrowDamage: {
					Label: Allow borrowing Damage stars from other classes
					Tooltip: If this mod should use the old system of having the max stat of the vanilla classes count towards Fishing Damage.
				}

				allowFishedItems: {
					Label: Allow this mod's fished items
					Tooltip: If the crates added by this mod should appear at all when fishing.
				}

				dontFallOnFloor: {
					Label: Bobbers always break
					Tooltip: If bobbers should never fall from the target when detatching.
				}

				explosivesDamageEveryone: {
					Label: Explosives damage everyone
					Tooltip: Should Grenade and Dynamite Bobbers damage everyone (including the player that triggered it), or not.
				}

				noSellItems: {
					Label: Items that should not be sold
					Tooltip: Items that the Sell Gate and Killing Gate will not replace with coins.
				}

				forceSellItems: {
					Label: Items that should always be sold
					Tooltip:
						'''
						Items that the Sell Gate and Killing Gate will replace with coins even if their max stack is not 1.

						Warning:Anything added here will take precedence to any other replacing, so if all fish from the replace option are here, no crates will appear.
						Same with Fish Steaks.
						'''
				}
			}
		}

		Currencies.FishSteaks: Fish Steaks

		TownNPCMood: {
			Fishylady: {
				Content: This place is ok, I guess.
				NoHome: I have no place to display my wares! Please, let me live somewhere.
				LoveSpace: I have no choice but to sell it cheap to thrive here.
				FarFromHome: I'm too far away from home. The trek there will be a killer!
				DislikeCrowded: I can raise prices here because there are so many customers...
				HateCrowded: There's more people here than in the Fish Market! That would be good if they bought something, but no...
				LikeBiome: Living in the {BiomeName} is not so bad!
				LoveBiome: I love the {BiomeName}, so many fish to catch and sell!
				DislikeBiome: I really don't like it here...
				HateBiome: This place is so bad, I don't feel like doing anything for you, {PlayerName}.
				LikeNPC: "{NPCName} is great! They buy lots and lots from me! They sometimes even sell me stuff too!"
				LoveNPC: Do you think {NPCName} notices me?
				DislikeNPC: That {NPCName} terrifies me! Is he Man or Machine?
				HateNPC: I hate {NPCName}. Why? No reason!
			}
		}

