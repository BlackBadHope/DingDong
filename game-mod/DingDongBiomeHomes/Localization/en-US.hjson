				}

				ExpForWeaponMult: {
					Tooltip: The number by which weapon experience gained will be multiplied
					Label: Exp For Weapon Mult
				}

				FromDamagePercent: {
					Tooltip: Additional experience that will be added before mult and other operations (exp + damage * ThisNumberInPercents)
					Label: From Damage Percent
				}

				FinalMult: {
					Label: Final Mult
					Tooltip: The number by which all experience gained will be multiplied
				}

				PriceMult: {
					Tooltip: The number by which experience price will be multiplied
					Label: Price Mult
				}

				StartPrice: {
					Label: Start Price
					Tooltip: The experience cost that goes with all items from the beginning
				}

				FlatExp: {
					Tooltip: Additional experience that will be added after all operations
					Label: Flat Exp
				}

				AdditionalExpBeforeMult: {
					Label: Additional Exp Before Mult
					Tooltip: Additional experience that will be added before mult and other operations
				}

				PriceIncreasePercent: {
					Tooltip: Additional experience price that will be added before all operations (newPrice = OldPrice + OldPrice * ThisNumberInPercents)
					Label: Price Increase Percent
				}

				AdditionalPrice: {
					Tooltip: Additional experience price that will be added before all operations
					Label: Additional Price
				}

				IncreaseBaseDamage: {
					Label: Increase Base Damage
					Tooltip: If this checkbox is enabled, the weapon's base damage increases, which will increase, for example, from some other items such as armor or accessories
				}

				ExpForArmorMult: {
					Label: Exp For Armor Mult
					Tooltip: The number by which armor experience gained will be multiplied
				}

				AdditionalPriceFlat: {
					Label: Additional Price Flat
					Tooltip: Additional experience price that will be added after all operations
				}

				IncreaseFlatDamage: {
					Label: Increase Flat Damage
					Tooltip: Additional damage after bonuses
				}

				IncreaseMultDamage: {
					Label: Increase Mult Damage
					Tooltip: Additional damage in percents
				}

				FromDamagePercentArmor: {
					Tooltip: Damage is converted to experience, the number is the percentage of damage that will become experience
					Label: From Damage Percent Armor
				}

				FromDamagePercentWeapon: {
					Tooltip: Damage is converted to experience, the number is the percentage of damage that will become experience
					Label: From Damage Percent Weapon
				}

				ExpFromGettingHit: {
					Tooltip: How much experience per hit. In this case - for taking damage from enemies
					Label: Exp From Getting Hit
				}

				ExpPerHit: {
					Tooltip: How much experience per hit. In this case - for dealing damage from enemies
					Label: Exp Per Hit
				}

				SocialAccessoriesRecieveExp: {
					Tooltip: Will accessories be upgraded in social slots?
					Label: Social Accessories Recieve Exp
				}

				AccessoriesRecieveExp: {
					Tooltip: Can accessories get defense?
					Label: Accessories Recieve Exp
				}

				SocialArmorRecieveExp: {
					Tooltip: Will armor be upgraded in social slots
					Label: Social Armor Recieve Exp
				}

				ArmorRecieveExp: {
					Tooltip: Can armor get defense?
					Label: Armor Recieve Exp
				}

				WeaponRecieveExp: {
					Tooltip: Can weapons get damage?
					Label: Weapon Recieve Exp
				}

				AccessoriesShouldHaveArmorToRecieveExp: {
					Tooltip: Do accessories need defense to be able to get it? Otherwise, all accessories will receive it
					Label: Accessories Should Have Armor To Recieve Exp
				}

				ArmorShouldHaveDefenseToRecieveExp: {
					Label: Armor Should Have Defense To Recieve Exp
					Tooltip: Do armor need defense to be able to get it? Otherwise, all armor will receive it
				}

				IgnoreDefence: {
					Label: Ignore Defence
					Tooltip:
						'''
						By default, experience is obtained from the damage received, in other words,
						you will receive almost no experience in your armor when you are hit, if you have too much armor,
						this is necessary so as not to pump up your armor for any reason. If you suffer, the mod helps you,
						if you don’t suffer, no. When enabled, the mod will look at the damage initially received,
						without taking into account armor and other resistances
						'''
				}

				MinionSlotsReduce: {
					Tooltip:
						'''
						THIS FEATURE CURRENTLY DOES NOT PROVIDE ADDITIONAL MINION SLOTS, IT WORKS COMPLETELY DIFFERENTLY.
						A player in Terraria has a number of slots for minions, and each minion (they are projectiles) has a price per slot. 
						For example, most minions cost 1 slot, while spiders cost less, so you’ll get more spiders for the same number of slots. 
						This stat implements this mechanic by reducing the cost of the projectile. You want at least one additional minion slot for stability. 
						Per Level = 1 at weapon level 25 will reduce the initial price of your minion by 25%. In the default config you need to reach level 100 to 
						double the number of minions for each of your slots. Here's how this stat works. It does not provide additional slots for minions.
						'''
					Label: Minion Slots Reduce
				}

				AdditionalProjectileOnShootChance: {
					Tooltip:
						'''
						The name says Chance, so it works like a chance. 
						At 250% chance you will fire 2 additional projectiles and have a 50% chance to fire another one. 
						Max limits the chance, not the number of projectiles. Necr0 used Per Level Mult = 25 in his videos.
						'''
					Label: Additional Projectile On Shoot Chance
				}

				UseMinionDamageFix: {
					Label: Use Minion Damage Fix
					Tooltip:
						'''
						There are quite a few weapons in the game that don't 
						rely on the GetWeaponDamage method that I use to increase weapon damage. This function will force minions to forcibly take weapon damage. 
						If this is turned off, your damage boost may not work.
						'''
				}

				UseMinionFix: {
					Tooltip:
						'''
						There are quite a few weapons in the game that don't 
						rely on the GetWeaponDamage method that I use to increase weapon damage. This function will force minions to forcibly take weapon damage. 
						If this is turned off, your damage boost may not work.
						'''
					Label: Use Minion Fix
				}

				ProjectileLifeTimeIncrement: {
					Label: Projectile Life Time Increment
					Tooltip:
						'''
						This stats somehow breaks projectiles. Most of the time everything is fine, but there have been complaints
						in the past that projectiles created by other projectiles (the minions that shoot)
						start to fly to the right. You can turn it on, but if you notice this problem, just turn it off.
						'''
				}

				LocalImmunModeOnProj: {
					Label: Local Immun Mode On Proj
					Tooltip:
						'''
						Changes the time when NPCs are invulnerable to your projectiles
						Some things make it possible to deal damage with all your projectiles, some work differently
						This setting is a little broken in terms of balance, so I recommend either not using it, or setting it to 10, or playing with the slider
						'''
				}
			}

