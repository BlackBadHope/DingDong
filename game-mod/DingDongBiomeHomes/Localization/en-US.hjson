		Configs: {
			SettingsConfigClient: {
				certainPotionsEnabled: {
					Tooltip: ""
					Label: certain Potions Enabled
				}

				DisplayName: LuiAFK Config Client
				Headers.Different_Enabling/Disabling_Options: Different Enabling / Disabling Options

				certainPotionsEnable: {
					Label: Certain Unlimited Potion
					Tooltip:
						'''
						If Certain Unlimited Potion is enabled or not.
						Will not trigger buffs if the Item is in inventory.
						Currently has no effect at all!!!!
						'''
				}
			}

			LuiAfkConfig: {
				harvesterAvailability: {
					Tooltip: ""
					Label: harvester Availability
				}

				potionsEnabled: {
					Tooltip: ""
					Label: potions Enabled
				}

				vanillaPotionsEnabled: {
					Tooltip: ""
					Label: vanilla Potions Enabled
				}

				PaperAmountForScrollCrafting: {
					Tooltip: ""
					Label: Paper Amount For Scroll Crafting
				}

				ultimateBattlerTimer: {
					Tooltip: ""
					Label: ultimate Battler Timer
				}

				DisplayName: Lui Afk Config

				Headers: {
					Harvester: Harvester Header
					Potions: Potions Header
				}
			}

			LuiAFKConfig: {
				DisplayName: LuiAFK Config Server

				Headers: {
					Harvester: Harvester Config
					Potions: Potions & Buffs Configs
					Accessories: Accessories Option
					NPC: NPCs Options
					Tools: Tools & Mics options
					Fishing: Fishing rods Bobbers
					Ammo: Ammo Options
				}

				harvesterAvailability: {
					Label: Harvesters
					Tooltip:
						'''
						At what difficulty Harvesters are available.
						Options are : Disabled, Normal+, Expert+ and Master+
						Default is Expert+
						'''
				}

				potionsEnable: {
					Label: Unlimited Potions
					Tooltip:
						'''
						If Unlimited Potions are enabled or not.
						Will not trigger buffs if the Item is in inventory.
						Will not trigger vanilla buffs if they are a stack of 30+.
						Default is true
						'''
				}

				vanillaPotionsEnable: {
					Label: Vanilla Potion Auto-Apply
					Tooltip:
						'''
						If Vanilla Potions are Auto-Applied if they are a Stack of 30+.
						Options are : Disabled, Always and 1 Unlimited Potion Present.
						Default value is 1 Unlimited Potion Present
						'''
				}

				PaperAmountForScrollCrafting: {
					Label: Paper amount for crafting
					Tooltip:
						'''
						The number of paper required for the scroll crafting.
						0 disable the paper needed for craft.
						Default value is 5.
						'''
				}

				ultimateBattlerTimer: {
					Label: Ultimate Battler Timer
					Tooltip:
						'''
						If Ultimate Battler Buff has a Timer of 5 seconds before the Buff is activated, before the Buff is deactivated or if the timer is disabled.
						Options are : Disabled, Before Enable and After Enable
						Default is Before Enable
						'''
				}

				manaEnable: {
					Label: Unlimited Mana [i:{0}] [i:{1}] [i:{2}] [i:{3}] [i:{4}] [i:{5}]
					Tooltip:
						'''
						If Unlimited Mana are enabled or not.
						Will not trigger buffs if the Item is in inventory.
						Default is true
						'''
				}

				superTools: {
					Label: Super Tools [i:{0}] [i:{1}] [i:{2}]
					Tooltip:
						'''
						If the Dig Faster, Tool time and Home Improvement are enabled or not.
						Will not trigger buffs if the Item is in inventory.
						Default is true
						'''
				}

				boneEnable: {
					Label: Spawn Bone Merchant Town NPC
					Tooltip:
						'''
						If the Bone Merchant is able to spawn or not.
						Will not remove already spawned Bone Merchant Town NPC.
						Default is true
						'''
				}

				merchantEnable: {
					Label: Spawn Travelling Merchant Town NPC
					Tooltip:
						'''
						If the Travelling Merchant Town NPC is able to spawn or not.
						Will not remove already spawned Travelling Merchant Town NPC.
						Default is true
						'''
				}

				builderEnable: {
					Label: Auto-Builders [i:{0}]
					Tooltip:
						'''
						If any Builder-Item/Tool is able to be obtained and used.
						Default is true
						'''
				}

				worldRemoverEnable: {
					Label: Improved Drill Mount [i:{0}]
					Tooltip:
						'''
						If Improved Drill Mount is able to be obtained and used.
						Default is true
						'''
				}

				moneyEnable: {
					Label: Money Collector [i:{0}]
					Tooltip:
						'''
						If Money Collector is able to be obtained and used.
						Default is true
						'''
				}

				killerEnable: {
					Label: Unlimited Merchant Killer [i:{0}]
					Tooltip:
						'''
						If Unlimited Merchant Killer is able to be obtained and used.
						Default is true
						'''
				}

				magnetEnable: {
					Label: Loot Magnet [i:{0}]
					Tooltip:
						'''
						If Loot Magnet is able to be obtained and used.
						Default is true
						'''
				}

				neededQuests: {
					Label: Extra Fishing Bobbers
					Tooltip:
						'''
						How many Angler quests are needed per extra bobber.
						0 disable this option.
						Value can go in between 0 to 100.
						Default is 5 quests
						'''
				}

				rangerAmmo: {
					Label: Unlimited Ammo Ranged Weapons
					Tooltip:
						'''
						How much Ranged Ammo you need for not consuming the item.
						0 disable this option.
						Values can go in between 0 to 10000.
						Default is 3996
						'''
				}

				thrownAmmo: {
					Label: Unlimited Ammo Thrown Weapons
					Tooltip:
						'''
						How much Thrown Ammo you need for not consuming the item.
						0 disable this option.
						Values can go in between 0 to 10000.
						Default is 999
						'''
				}
			}
		}

