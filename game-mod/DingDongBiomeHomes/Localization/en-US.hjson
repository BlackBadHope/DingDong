	AnglerArmorBonus: {
		Configs: {
			ServerConfig: {
				DisplayName: Server Config

				extraFishingLines: {
					Label: Extra Fishing Lines
					Tooltip: Determines the number of extra fishing lines for the Angler Armor Set Bonus.
				}

				doubleCatchChance: {
					Label: Double Catch Chance
					Tooltip: Determines the chance to get double the amount of the usual catch per fishing line.
				}

				tripleCatchChance: {
					Label: Triple Catch Chance
					Tooltip:
						'''
						Determines the chance to get triple the amount of the usual catch per fishing line.
						This check will only proceed if Double Catch Chance is successful.
						'''
				}

				maxStackLimit: {
					Label: Max Stack Limit
					Tooltip:
						'''
						Catches that trigger the double/triple catch chance will never exceed allowable max stack for the catch.
						e.g. Triple catching Frog Legs will make the item have a stack of 3.
						This config will set Frog Legs to 1 even if it was tripled.
						'''
				}
			}
		}
	}

	MaxStackExtra: {
		Configs: {
			MaxStackExtraConfig: {
				TileStackValue: {
					Tooltip: Configure the maximum stack size for tiles
					Label: Maximum stack for tiles
				}

				ItemStackValue: {
					Tooltip: Configure the maximum stack size for items.
					Label: Maximum stack for items
				}

				DisplayName: Max Stack Extra Config

