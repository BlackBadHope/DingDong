					Label: Enable
					Tooltip: Enable
				}

				Headers: {
					Circular: Circular duplicating
					Separate: Sideways duplicating
					OnPosition: Position-based duplicating
					BySpeed: Velocity-based duplicating
					Additional: Customized duplicating
				}

				duplicateCircularEnabled: {
					Label: Enable circular duplicating
					Tooltip: Enable circular duplicating
				}

				duplicateCircular: {
					Label: Duplicated projectiles is evenly distributed in a circle
					Tooltip: Duplicated projectiles is evenly distributed in a circle
				}

				duplicateSeparatesEnabled: {
					Label: Enable sideways duplicating
					Tooltip: Enable sideways duplicating
				}

				duplicateSeparates: {
					Label: Duplicate a projetile on each side of the original one
					Tooltip: Duplicate a projetile on each side of the original one
				}

				duplicateOnPositionsEnabled: {
					Label: Enable position-based duplicating
					Tooltip: Enable position-based duplicating
				}

				duplicateOnPositions: {
