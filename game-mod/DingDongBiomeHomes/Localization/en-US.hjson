			ArenaBuilder: {
				DisplayName: Arena Platform Builder
				Tooltip:
					'''
					Builds a platform ~200 blocks wide.
					Right click to choose options, choose platform material and extras
					Will automatically use Asphalt Platforms if you have them in your inventory.
					Choosing the campfire will place campfires.
					And will also place bubble blocks for honey placement.
					Choosing the light will make the platform be lit up all the way along.
					Won't destroy tiles.
					'''
			}

			FishingBiomeBuilder: {
				DisplayName: Fishing Biome Builder
				Tooltip:
					'''
					Builds a biome for fishing.
					Right-click to choose options.
					Select obsidian to place jungle or mushroom wall behind the tiles.
					Select wood/stone material for outer barrier.
					Toggle the light to choose whether you want it lit or not.
					Pearlstone/Hallow Ice only usable in Hardmode.
					'''
			}

			FishingBuilder: {
				DisplayName: Pool Builder
				Tooltip:
					'''
					Use to build a fishing pool or place/remove liquid.
					Right-click to choose options.
					Works like the Ultimate Liquid Manipulator when Fishing Pool Builder is off.
					With Fishing Pool Builder on using it will create a fishing pool with your chosen liquid.
					Pool will be empty if you choose the sponge (no platforms or outer tiles).
					With obsidian on a back wall will be placed (sponge included).
					'''
			}

			GroundFiller: {
				DisplayName: Dirt Rod 2.0
				Tooltip:
					'''
					Right-click to change modes.
					Mode 1: Levels and fills the ground beneath you, 300 wide, 50 deep.
					Mode 2: Also clears 50 tiles up.
					Mode 3: Also works on Dungeon, Temple, and Underground Desert, leaving background wall.
					Modded tiles will be replaced with vanilla tiles.
					'''
			}

			Hellevator: {
				DisplayName: Auto Hellevator
				Tooltip:
					'''
					Builds a hellevator.
					Right-click to choose options.
					Will be lit up all the way down if you have the light on.
					Will only place rope if you have one of the Unlimited Rope items in your inventory.
					Click where you want the top right hellevator wall.
					Will stop if it hits the Temple.
					'''
			}

			PrisonBuilder: {
				DisplayName: Prison Builder
				Tooltip:
					'''
					Builds an NPC prison.
					Right-click to choose options.
					Will be lit up if the light is on (will count as a house either way).
					Click where you want the bottom right block.
					'''
			}

			SkyPlatformBuilder: {
				DisplayName: Skybridge Builder
				Tooltip:
					'''
					Builds a platform the length of the map.
					Right-click to choose options.
					Will be lit up all the way along if you have the light on.
					Won't destroy tiles.
					Will automatically use Asphalt Platforms if you have them in your inventory.
					'''
			}

			SubAndSky: {
				DisplayName: Minecart or Platform Builder
				Tooltip:
					'''
					Right-click to choose options.
					Will be lit up all the way along if you have the light on.
					Platform material can be Obsidian (takes priority), or the woods.
					If you have Unlimited Asphalt Platforms in your inventory, these will be placed instead.
					Choosing Obsidian will make the Minecart lay without walls/floor.
					Placing platforms will destroy tiles.
					Click where you want the Minecart Track or the Platform to be
					Will go through the temple if Golem is dead.
					'''
			}

			SubwayBuilder: {
				DisplayName: Subway Builder
				Tooltip:
					'''
					Builds a subway.
					Right-click to choose options.
					Will be lit up all the way along if you have the light on.
					Click where you want the Minecart Track to be.
					Will go through the temple if Golem is dead.
					'''
			}

			InstantMoonLord: {
				DisplayName: Instant Moon Lord Summon
				Tooltip: Skips Impending Doom.
			}

			NoAltarGolem: {
				DisplayName: Golem Summon
				Tooltip:
					'''
					Summons Golem with out the Lihzahrd Altar.
					Only usable when Golem has been killed.
					'''
			}

			NoFishDuke: {
				DisplayName: Fishron Summon
				Tooltip: Summons Fishron with out having to fish.
			}

			WallSummon: {
				DisplayName: Bloody Guide Voodoo Doll
				Tooltip:
					'''
					Summons Wall of Flesh with out needing the Guide.
					Only usable after Wall of Flesh has been killed.
					'''
			}

