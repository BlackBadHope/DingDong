	RandomLoot: {
		Configs: {
			RandomLootConfig: {
				ChestLootRandomizer: {
					Tooltip: ""
					Label: Chest Loot Randomizer
				}

				BossLootRandomizer: {
					Tooltip: ""
					Label: Boss Loot Randomizer
				}

				EnemyLootRandomizer: {
					Tooltip: ""
					Label: Enemy Loot Randomizer
				}

				DisplayName: Random Loot Config
			}

			ChestLootRandomization: {
				Tooltip: ""

				RandomChestLoot: {
					Tooltip:
						'''
						Toggle to enable/ disable the random loot chance for chests.
						Note:
						- Max stack for stackable items is 5.
						- Only fills slots that originally had an item.
						- Only works when creating a new world after enabling. Chests generate during world creation.
						'''
					Label: Chest Loot Randomization
				}

				DetailedChestRandomLootChance: {
					Tooltip:
						'''
						The additional chance is added after the dot of the random loot chance.
						Example:
						Random chest loot chance is set to 1 and additional chance is set to 0.25.
						Those values will then combine to 1.25%. Any combination is possible.
						'''
					Label: Additional Chest Loot Chance
				}

				ChestRandomLootChance: {
					Tooltip:
						'''
						Chance for a random item in each chest slot to appear.
						Only affects chest loot randomization.
						'''
					Label: Random Chest Loot Chance
				}
			}

			BossLootRandomization: {
				Tooltip: ""

				RandomBossDrops: {
					Tooltip: Toggle to enable/ disable the random loot dropchance for bosses.
					Label: Boss Drop Randomization
				}

				DetailedBossRandomLootChance: {
					Tooltip:
						'''
						The additional chance is added after the dot of the random loot chance.
						Example:
						Random boss loot dropchance is set to 1 and additional chance is set to 0.25.
						Those values will then combine to 1.25%. Any combination is possible.
						'''
					Label: Additional Boss Loot Dropchance
				}

				BossRandomLootChance: {
					Tooltip:
						'''
						Dropchance of random loot from bosses in %. 
						Only affects boss drop randomization.
						'''
					Label: Random Boos Loot Dropchance
				}
			}

			EnemyLootRandomization: {
				Tooltip: ""

				RandomEnemyLoot: {
					Tooltip: Toggle to enable/ disable the random loot dropchance for non-boss enemies.
					Label: Enemy Drop Randomization
				}

				DetailedEnemyRandomLootChance: {
					Tooltip:
						'''
						The additional chance is added after the dot of the random loot chance.
						Example:
						Random enemy loot dropchance is set to 1 and additional chance is set to 0.25.
						Those values will then combine to 1.25%. Any combination is possible.
						'''
					Label: Additional Enemy Loot Dropchance
				}

				EnemyRandomLootChance: {
					Tooltip:
						'''
						Dropchance of random loot from enemies in %. 
						Only affects enemy drop randomization.
						'''
					Label: Random Enemy Loot Dropchance
				}
			}
		}
	}

