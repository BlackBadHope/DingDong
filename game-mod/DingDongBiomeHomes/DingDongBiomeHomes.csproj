<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TmlTargetsPath Condition="'$(TmlTargetsPath)' == '' and Exists('..\tModLoader.targets')">..\tModLoader.targets</TmlTargetsPath>
    <TmlTargetsPath Condition="'$(TmlTargetsPath)' == '' and '$(TML_HOME)' != ''">$(TML_HOME)/tMLMod.targets</TmlTargetsPath>
  </PropertyGroup>

  <Import Project="$(TmlTargetsPath)" />

  <PropertyGroup>
    <AssemblyName>DingDongBiomeHomes</AssemblyName>
    <RootNamespace>DingDongBiomeHomes</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <BuildMod>false</BuildMod>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
	<DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;Tests\obj\**;Tests\bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
